---
interface Props {
    entry: TimelineEntry;
}

const { entry } = Astro.props


import NodeBasic from "./DisplayNodes/NodeBasic.astro"
import NodeMinor from "./DisplayNodes/NodeMinor.astro"
import NodeImage from "./DisplayNodes/NodeImage.astro"
import NodeTwitter from "./DisplayNodes/NodeTwitter.astro"
import NodeTruth from "./DisplayNodes/NodeTruth.astro"
import NodeYoutube from "./DisplayNodes/NodeYoutube.astro"
import NodeYoutubeGroup from "./DisplayNodes/NodeYoutubeGroup.astro"
import type { TimelineEntry } from "../utils/inlineToTimeline"

const nodeMap = {
    Basic: NodeBasic,
    Minor: NodeMinor,
    Image: NodeImage,
    Twitter: NodeTwitter,
    Truth: NodeTruth,
    Youtube: NodeYoutube,
    YoutubeGroup: NodeYoutubeGroup
}
const NodeComponent = nodeMap[entry?.Display as keyof typeof nodeMap] ?? NodeBasic
---
<NodeComponent entry={entry}/>