---
import type { TimelineData, TimelineEntry } from "../utils/inlineToTimeline";
import AtomDisplayNode from "./AtomDisplayNode.astro"
import DynamicModalLink from "./DynamicModalLink.astro";
import TimelineButtons from "./TimelineButtons.astro";
import YearSpan from "./TimelineComponents/YearSpan.astro";
import MonthSpan from "./TimelineComponents/MonthSpan.astro";
import TimelineSpans from "./TimelineComponents/TimelineSpans.astro";
import NodeTimeDay from "./TimelineComponents/NodeTimeDay.astro";

interface Props {
    timelineData: TimelineData
}

const { timelineData } = Astro.props
---
<style is:global>
h1 {
    text-align: center;
}
.timeline-base {
    justify-self: center;
    display: grid;
    grid-template-columns: min-content min-content 40px auto min-content;
    gap: 0px;
    background: var(--secondary-bg);
    width: 100%;
    max-width: 100%;
    min-width: 0% !important;
    > * {
        min-width: 0%;
    }
}
.timeline-sizer {
    max-width: 100%;
    width: 100%;
}
.timeline-cell {
    display: grid;
    align-items: center;
    grid-column: 2 / 3;
    width: 100%;
    p {
        margin: 0;
    }
}
.timeline-cell.entry.basic {
    margin: 8px 0;
}
.timeline-cell.entry.image {
    margin: 24px 0 24px 0;
    grid-column: 1 / -1 !important;
    grid-template-columns: subgrid;
}


.timeline-cell.buttons {
    margin: 8px;
    align-content: center;
}
.timeline-line {
    background: light-dark(var(--text-color), var(--border-basic));
    width: 1px;
    height: calc(100%);
    justify-self: center;
    animation-name: line-go-down;
    animation-duration: 3000ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
}
.node-circles {
    width: 15px;
    height: 15px;
    border-radius: 20px;
    border: 0px solid var(--border-basic);
    background: light-dark(var(--color-accent), var(--color-accent));
    place-self: center;
    animation-name: opacity-reveal;
    animation-duration: 500ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    animation-delay: var(--anim-delay);
    &.Minor {
        width: 10px;
        height: 10px;
        border-radius: 15px;
        border: 0px solid var(--border-basic);
        background: light-dark(var(--color-accent), var(--color-accent));
    }
}
#span-column {
    padding-left: 8px;
    display: grid;
    width: auto;
    height: 100%;
    grid-template-rows: subgrid;
    margin-right: 8px;
    position: relative;
    gap: 0 4px;
}





@media only screen and (max-width: 640px) { 
    .timeline-base {
        grid-template-columns: min-content auto min-content;
    }
    .year {
        font-size: 2.3rem;
        margin: 0;
        padding: 0;        
    }


    .node-circles {
        grid-column: 2 / 3 !important;
        display: none; 
    }
    #span-column {
        margin-left: 8px !important;
        gap: 0px 2px;
        grid-auto-columns: min-content;
    }
    .timeline-span {
        width: 20px;
        background: hsl(from var(--border-basic) h s calc(l*.5) );
        border: none;
        border-radius: 4px;
        &:hover {
            background: hsl(from var(--border-basic) h s calc(l));
        }
    }
    .timeline-line { 
        grid-column: 2 / 3 !important;
        display: none;
    }
    .timeline-cell.entry {
        grid-column: 1 / 4 !important;
        display: grid;
        grid-template-columns: subgrid;
        width: 100%;
        .display-node:not(.image) {
            grid-column: 2 / 3;
        }
    }

    .timeline-cell.entry.image {
        grid-column: 1 / 4 !important;
        margin: 0;
        .display-node.image {
            grid-column: 1 / 4;
            grid-template-columns: subgrid;
            .name-link {
                grid-column: 2 / 4;
            }
            img {
                grid-column: 1 / 4;
            }
        }
    }
    .timeline-cell.buttons {
        grid-column: 3 / 4 !important;
        padding: 0px;
        margin: 0px;
        height: 100%;
        .button-container {
            flex-direction: column;
        }
    }
    .timeline-cell.entry.basic {
        margin: 0px 0px;
        padding: 8px 0px;
        background: var(--primary-bg);
    }
    .timeline-cell.entry.twitter {
        background: black;
        padding-right: 16px;
    }
    .timeline-cell.entry.truth {
        background: white;
        padding-right: 16px;
    }

}
@media only screen and (min-width: 640px) {
    .timeline-sizer {
        position: relative;
        overflow: clip;
    }
    .timeline-sizer::after {
        border: 1px solid var(--border-basic);
        border-radius: 16px;
        content: "";
        z-index: 10;
        position: absolute;
        display: block;
        inset: 0 0 0 0;
        pointer-events: none;
    }
}
</style>
  <div class="timeline-sizer">
    <div class="timeline-base">
    {timelineData.Years.map((year: { yIndex: number; yEnd: any }) => {
    
    return (
        <div class="timeline-line" style={`grid-column: 3 / 4; grid-row: ${year.yIndex + 1} / ${year.yEnd};`}> 
        </div>
    )})}
    <TimelineSpans timelineData={timelineData} />
    {timelineData.Years.map((year: { yIndex: number; year: unknown }, yearsInd: number) => {
        let end = year.yIndex + 1
        if (yearsInd !== timelineData.Years.length - 1) {
            end = timelineData.Years[yearsInd + 1].yIndex + 1
        } else {
            end = timelineData.Length
        }
        return (<YearSpan year={year.year} start={year.yIndex} end={end}/>
      )})}
  {timelineData.Months.map((month: { yIndex: number; month: unknown }, monthInd: number) => {
    let end = month.yIndex + 1
    if (monthInd !== timelineData.Months.length - 1) {
        end = timelineData.Months[monthInd + 1].yIndex + 1
    } else {
        end = timelineData.Length
    }
    return (
        <MonthSpan month={month.month} start={month.yIndex} end={end}/>
      )})}

    {timelineData.Entries.map((atom: TimelineEntry) => (
      <div class={`node-circles ${atom.Display}`}
      style={`
        grid-column: 3 / 4;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 125}ms`
      }/>
    ))}
    {timelineData.Entries.map((entry: TimelineEntry) => (
      <NodeTimeDay 
        ordinalDay={entry.Properties.OrdinalDay} 
        dateString={entry.Properties.DateString} 
        displayClass={entry.Display} 
        index={entry.Index} 
      />
    ))}
    {timelineData.Entries.map((entry: TimelineEntry) => (
      <div class={`timeline-cell entry ${entry.Display.toLowerCase()}`}
      style={`
        grid-column: 4 / 5;
        grid-row: ${entry.Index} / ${entry.Index + 1};
        --anim-delay: ${entry.Index * 90}ms`
      }>
        <AtomDisplayNode entry={entry}/> 
      </div>  
      ))}
      {timelineData.Entries.map((entry: TimelineEntry) => (
      <div class={`timeline-cell buttons ${entry.Display.toLowerCase()}`} 
      style={`
        grid-column: 5 / 6;
        grid-row: ${entry.Index} / ${entry.Index + 1};
        --anim-delay: ${entry.Index * 90}ms`
      }>
        <TimelineButtons commentary={entry.Properties?.Commentary} targetUrl={entry.Properties.SourceLink} paywalled={entry.Properties?.Paywalled} index={entry.Index}/> 
      </div>  
      ))}
    </div>
  </div>