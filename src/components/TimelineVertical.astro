---
import AtomDisplayNode from "./AtomDisplayNode.astro"
const { timeline } = Astro.props
---
<style is:global>
.timeline-base {
    display: grid;
    grid-template-columns: min-content auto 40px auto;
    gap: 0px;
    background: var(--secondary-bg);

    width: 100%;
    max-width: 100%;
    min-width: 0%;
}


.popover-buttons {
    display: flex;
    gap: 8px;
    margin-left: 32px;
    margin-right: 8px;
}
.commentary-button, .content-button {
    opacity: 0;
    border: none;
    display: inline flex;
    font-weight: 1000;
    text-align: center;
    place-content: center;
    place-items: center;
    transition-property: opacity;
    transition-duration: 250ms;
    flex-shrink: 0;
    background: var(--border-basic);
    color: var(--primary-bg);
    font-size: 1.3rem;
    overflow: hidden;
    height: 28px;
    width: 28px;
    border-radius: 4px;

}

.node-commentary-popover, .node-content-popover {
    max-width: 480px;
    border: 1px solid var(--border-basic);
    background: var(--primary-bg);
    color: var(--text-color);
    font-family: Noto Sans;
    font-size: .75em;
    padding: 1em;
    border-radius: 6px;
    position-area: top;
    position-try: flip-block;
    margin-bottom: 10px;
    opacity: 0;
    transition: opacity 200ms;
    &:popover-open {
        opacity: 1;
        @starting-style {
            opacity: 0;
        }
    }
}

.timeline-cell:hover .commentary-button,
.timeline-cell:hover .content-button {
    opacity: 1;
}

.timeline-cell {
    display: grid;
    align-items: center;
    grid-column: 2 / 3;
    width: 100%;
    box-sizing: border-box;
    &:has(.basic) {
        padding-right: 16px;
    }
    &:has(.display-node.image) {
        align-items: inherit;
        grid-column: 1 / 5 !important;
        margin: 0 - 0rem;
        width: calc(100% + 0rem);
        .display-node {
            border-width: 1px 0 1px 0;
            border-style: solid;
            border-color: var(--border-basic);
            border-radius: 0;
        } 
    }
    p {
        margin: 0;
    }
    &.year {
        color: var(--text-color-important);
        font-weight: 600;
        font-size: 3rem;
        text-align: center;
        place-items: center;
        margin: 0;
        width: calc(100%);
    } 
    hr {
        width: 100%;
        border: none;
        border-bottom: 1px solid hsl(0 0 30);
        margin: 0px;
    }
    &.month {
        width: 100%;
        text-align: right;
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text-color);
        z-index: 2;
        animation-name: opacity-reveal;
        animation-duration: 800ms;
        animation-timing-function: ease-in;
        animation-fill-mode: both;
        animation-delay: var(--anim-delay);
        margin-top: 24px;
        p { 
            background: hsl(from var(--secondary-bg) h s l / .5);
            width: 100%;
        }
    }
}
.timeline-range {
    display: none;
}

.timeline-line {
    background: var(--border-basic);
    width: 1px;
    height: calc(100% - 64px);
    justify-self: center;
    animation-name: line-go-down;
    animation-duration: 3000ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    margin: 48px 0;
}
.node-circles {
    width: 15px;
    height: 15px;
    border-radius: 20px;
    border: 1px solid var(--border-basic);
    background: var(--secondary-bg);
    place-self: center;
}

.node-circles {
    width: 15px;
    height: 15px;
    border-radius: 20px;
    border: 1px solid var(--border-basic);
    background: var(--secondary-bg);
    place-self: center;
    animation-name: opacity-reveal;
    animation-duration: 500ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    animation-delay: var(--anim-delay);
    &.Minor {
        width: 10px;
        height: 10px;
        border-radius: 15px;
        border: 1px solid var(--border-basic);
        background: var(--secondary-bg);
    }
}
.node-day-time {
    font-size: 0.8rem;
    color: var(--text-color);
    place-self: center right;
}
#span-column {
    padding-left: 8px;
    display: grid;
    width: auto;
    height: 100%;
    grid-template-rows: subgrid;
    margin-right: 8px;
    position: relative;
    gap: 0 4px;
}

.timeline-span {
    width: 20px;
    height: calc(100% - 8px);
    margin: -48px auto auto 0;
    background: light-dark(
        hsl(from var(--border-basic) h s l / .3),
        hsl(from var(--border-basic) h s l / .2)
    );
    border-color:  light-dark(
        hsl(from var(--border-basic) h s l / 1),
        hsl(from var(--border-basic) h s l / .5)
    );
    border-width: 0 1px 0 1px;
    border-style: solid;
    transition: border 250ms ease, background 400ms ease;
    &:hover {
        border-color: hsl(from var(--border-basic) h s l / .7);
        background: hsl(from var(--border-basic) h s l / .2);
        .span-name {
            opacity: 1;
            transform: translateX(25px);
        }
    }
} 

.span-name {
    opacity: 0;
    pointer-events: none;
    place-self: right;
    position: sticky;
    width: 125px;
    top: 50%;
    padding: .5em;
    border-radius: 8px;
    transition: opacity 100ms ease, transform 300ms ease;
    background: var(--primary-bg);
    border: 1px solid var(--border-basic);
    color: var(--text-color);
    z-index: 5;
}




@media only screen and (max-width: var(--mobile-width)) {
    
    h1 {
        font-size: 2em;
    }

    .popover-buttons {
        margin-left: auto;
        padding-left: 8px;
    }
    .content-button, .commentary-button { 
        opacity: 1;

    }
    .timeline-base {
        grid-template-columns: auto 10px auto;
        gap: 0 4px;
        padding: 0px;
        max-width: 100%;
        width: 100%;

    }
    .timeline-cell:has(.display-node.image) {
        margin: 0px;
        width: 100%;
    }

    .year {
        font-size: 2.3rem;
        margin: 0;
        padding: 0;        
        }
    .timeline-range.year {
        display: flex;
        align-items: start;
        overflow-y: visible;
        height: 100%;
        position: relative;
        pointer-events: none;
        div {
            box-sizing: border-box;
            position: sticky;
            text-align: center;
            height: 50px;
            top: 40px;
            width: 100%;
            margin: 0px;
            
            background: var(--secondary-bg);
            z-index: 7;
            p {
                margin: auto;
                font-weight: 600;
            }
        }
    }
    .timeline-cell.year {
        height: 50px;
    }
    .timeline-cell.month {
        opacity: 0
    }
    .timeline-cell.month, .timeline-range.month {
        grid-column: 1 / 5 !important;
        align-items: start;
        margin: 0;
        border-color: var(--primary-bg);
        border-style: solid;
        border-width: 0px 0 0px 0;
        width: 100%;
        text-align: center;
        position: relative;
        overflow-y: visible;
        height: 100%;
        pointer-events: none;

    }
    .timeline-range.month {
        display: flex;
        align-items: start;
        overflow-y: visible;
        height: 100%;
        position: relative;
        pointer-events: none;
        p {
            height: min-content;
            background: var(--border-basic);    
            position: sticky;
            top: 90px;
            width: 100%;
            z-index: 6;
            margin: 0
        }
    }
    .node-circles {
        grid-column: 2 / 3 !important;
        display: none; 
    }
    #span-column {
        margin-left: 8px !important;
        gap: 0px 2px;
        grid-auto-columns: min-content;
    }
    .timeline-span {
        width: 20px;
        background: hsl(from var(--border-basic) h s calc(l*.5) );
        border: none;
        border-radius: 4px;
        &:hover {
            background: hsl(from var(--border-basic) h s calc(l));
        }
    }
    .timeline-line { 
        grid-column: 2 / 3 !important;
        display: none;
    }
    .timeline-cell.node {
        grid-column: 2 / 5 !important;
        margin: 0;
        width: 100%;
    }
    .timeline-cell.node:has(.basic), .timeline-cell.node:has(.image) {
        grid-column: 1 / 5 !important;
        background: var(--primary-bg);
        display: grid;
        grid-template-columns: subgrid;
    }
    
    .node-day-time {
        grid-column: 1 / 2 !important;
        font-size: 1em;
        display: flex; 
        flex-direction: column;
        background: hsl(from var(--primary-bg) h s l / .75);
        padding: 0 4px;
        border-radius: 16px;
        border-color: var(--border-basic);
        border-width: 0px;
        border-style: solid;
        margin: auto;
        padding: 1px 6px;
        border-radius: 0px;
        z-index: 4;
        p {
            padding: 0;
            height: auto;
            margin: 0;
        }
        .node-day {
            font-weight: bold;
        }
        .node-time {
            font-size: .9em;
        }
        &.Minor {
            background: var(--secondary-bg);
        }
    }

}

</style>
  <div class="timeline-base">
    {timeline.Years.map((year: { yIndex: number; yEnd: any }) => {
    
    return (
        <div class="timeline-line" style={`grid-column: 3 / 4; grid-row: ${year.yIndex + 1} / ${year.yEnd};`}> 
        </div>
    )})}
    <div id="span-column" style={`grid-column: 1 / 2; grid-row: 1 / ${timeline.Length};`}>
        {timeline.Spans.map((span: { yIndex: number; yEnd: number; trackInd: number; name: unknown }) => {
        return (       <div class="timeline-span" style={`grid-row: ${span.yIndex + 1} / ${span.yEnd +1}; grid-column: ${span.trackInd + 1}`}>
            <div class="span-name" style={`grid-row: ${span.yIndex} / ${span.yEnd +1}; grid-column: ${span.trackInd + 1}`}>
                {span.name}
            </div>
            
        </div>
        )})}
    </div>
    {timeline.Years.map((year: { yIndex: number; year: unknown }, yearsInd: number) => (
      <div class="timeline-cell year spacer"
      style={{
        gridColumn: "1 / 5",
        gridRow: `${year.yIndex} / ${year.yIndex + 1}`,
      }}>
      <div><p>{year.year}</p></div>
      <hr/>
      </div>
      <div class="timeline-range year" 
      style={{
        gridColumn: "1 / 5",
        gridRow: `${year.yIndex} / ${timeline.Years[Math.min(yearsInd + 1, timeline.Years.length - 1)].yIndex + 1}`,
      }}>
        <div><p>{year.year}</p></div>
        
      </div>
      ))}
  {timeline.Months.map((month: { yIndex: number; month: unknown }, monthInd: number) => (
    <div class="timeline-cell month spacer"
      style={{
        gridColumn: "1 / 3",
        gridRow: `${month.yIndex} / ${month.yIndex + 1}`,
      }}>
        <p>
      {month.month} 
      </p>
      </div>
      <div class="timeline-range month" 
      style={`
        --anim-delay: ${month.yIndex * 75}ms;
        grid-column: 2 / 3;
        grid-row: ${month.yIndex} / ${timeline.Months[Math.min(monthInd + 1, timeline.Months.length - 1)].yIndex};
      `}>
        <p>{month.month} </p>
      </div>  
      ))}

    {timeline.Nodes.map((atom: { Display: any; Index: number }) => (
      <div class={`node-circles ${atom.Display}`}
      style={`
        grid-column: 3 / 4;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 125}ms`
      }/>
    ))}
    {timeline.Nodes.map((atom: { Display: any; Index: number; OrdinalDay: unknown; DateString: string }) => (
      <div class={`node-day-time ${atom.Display}`} 
      style={`
        grid-column: 2 / 3;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 125}ms`
      }>
        <p class="node-day">{atom.OrdinalDay}</p> {atom.DateString.split("T")[1] ? <p class="node-time"> {atom.DateString.split("T")[1]}</p> : ""}
      </div>
    ))}
    {timeline.Nodes.map((atom: any) => (
      <div class="timeline-cell node" 
      style={`
        grid-column: 4 / 5;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 90}ms`
      }>
        <AtomDisplayNode atom={atom}/> 
      </div>  
      ))}

  </div>