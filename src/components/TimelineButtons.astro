---
import DynamicModalLink from "./DynamicModalLink.astro";
import { MessageCircleQuestionMark, FileLock, SquareText } from '@lucide/astro'

interface Props {
  targetUrl: string;
  index: number;
  buttonText?: string;
  paywalled?: boolean;
  commentary?: string;
}
const { targetUrl, index, buttonText = "View Highlighted Text", paywalled, commentary } = Astro.props;

let commentaryComponent 
if (commentary) {
commentaryComponent = `<button class="commentary-button" popovertarget="commentary-${index}">?</button>
<div popover id="commentary-${index}" class="node-commentary-popover">
    ${commentary}
</div>`
}

let Icon =  SquareText
if (paywalled) {
  Icon = FileLock
}

---

