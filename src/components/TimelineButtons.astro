.timeline-button {
    height: 32px;
    border: 1px solid var(--border-basic);
}
.button-container {
    justify-content: right;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 8px;
    padding: 0 8px;
    margin-right: 8px;
    height: 100%;
}
.lucide {
    color: var(--border-hover);
    stroke-width: 2px;
}
@media only screen and (max-width: 640px) {
    .button-container {
        gap: 0px;
        padding: 0px;
        height: 100%;
    }
    .timeline-button {
        max-width: 100%;
        min-height: 32px;
        max-height: 100%;
        height: 100%;
        flex-grow: 1;
        border: none;
        background: hsl(from var(--border-basic) h s calc(l *.5));
    }
}
</style>
<div class="button-container">
{commentary ? 
    <button class="commentary-button timeline-button" popovertarget="commentary-${index}"><MessageCircleQuestionMark/></button>
    <div popover id="commentary-${index}" class="node-commentary-popover">
        {commentary}
    </div> 
: ""}
<button type="button" class="timeline-button popup-trigger" data-url={targetUrl}>
    <Icon/>
    <DynamicModalLink targetUrl={targetUrl}/>
</button>
</div>
