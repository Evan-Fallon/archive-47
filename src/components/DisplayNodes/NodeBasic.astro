---
import type { TimelineEntry } from '../../utils/inlineToTimeline'
import DynamicModalLink from '../DynamicModalLink.astro'
interface Props {
    entry: TimelineEntry;
}
const { entry } = Astro.props



---
<style>
.display-node.basic {
    display: flex;
    flex-direction: column;
    background: var(--primary-bg);
    padding: var(--title-padding);
    max-width: 720px;
}
.display-node.basic .content {
    color: var(--text-color);
    
    font-size: .8rem;
}
.display-node.basic .name-link p {
    color: var(--text-color-important);
    font-weight: bold;
    font-size: 1.1em;
    text-decoration: none;
    text-wrap: balance;
    margin-bottom: 8px;
}

@media only screen and (max-width: 640px) {
.display-node.basic {
        margin: 6px 0;
        grid-column: 2 / 3; 
        border-width: 0px;
        paddng: 4px;
        max-width: 100%;   
        width: 100%;
        min-width: 10px;
        .name-link {
            margin-bottom: 8px;
            font-size: .9rem;
        }
        .content-embed {
            font-size: .8rem;
        }
    }
}  
    .popover-buttons {
        flex-direction: column;
    }

</style>
<div class="display-node basic">
    <div class="name-link">
            <p>{entry.EntryName}</p>
    </div>
    <div class="content">
        <div class="content-embed">{entry.Properties.PriorLine}</div>
    </div>
</div>
