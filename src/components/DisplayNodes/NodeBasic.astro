---
import type { TimelineEntry } from '../../utils/inlineToTimeline'
import DynamicModalLink from '../DynamicModalLink.astro'
import { stripAtomFormatting } from '../../utils/stripAtomFormatting'
import { Marked } from 'marked'

interface Props {
    entry: TimelineEntry;
}
const { entry } = Astro.props

const priorLine = stripAtomFormatting(entry.Properties.PriorLine)
const priorLineHtml = await new Marked().parse(priorLine)
---
<style>
.display-node.basic {
    display: flex;
    flex-direction: column;
    background: var(--primary-bg);
    padding: var(--title-padding);
    max-width: 720px;
}
.display-node.basic .content {
    color: var(--text-color);
    
    font-size: .8rem;
}
.display-node.basic .name-link p {
    color: var(--text-color-important);
    font-weight: bold;
    font-size: 1.1em;
    text-decoration: none;
    text-wrap: balance;
    margin-bottom: 8px;
}
.display-node.basic :global(ol) {
    padding-left: 1.5rem;
    margin: 0px;
    & :global(::marker) {
        color: hsl(from var(--text-color) h s l / .5);
        font-weight: bold;
    }
}
.display-node.basic :global(blockquote) {
    margin: .2rem 0px .2rem .2rem;
    padding: .2rem .2rem .2rem 1rem;
    position: relative;
    &::before {
        content: "";
        display: block;
        position: absolute;
        inset: 0 0 0 0;
        background: hsl(from var(--border-basic) h s l / .25);
        border-left: 8px solid hsl(from var(--border-basic) h s l / .35);
        border-radius: 4px;
    }
}
@media only screen and (max-width: 640px) {
.display-node.basic {
        margin: 6px 0;
        grid-column: 2 / 3; 
        border-width: 0px;
        padding: 4px;
        max-width: 100%;   
        width: 100%;
        min-width: 10px;
        .name-link {
            margin-bottom: 8px;
            font-size: .9rem;
        }
        .content-embed {
            font-size: .8rem;
        }
    }
}  
    .popover-buttons {
        flex-direction: column;
    }

</style>
<div class="display-node basic">
    <div class="name-link">
            <p>{entry.EntryName}</p>
    </div>
    <div class="content">
        <div class="content-embed" set:html={priorLineHtml}></div>
    </div>
</div>
