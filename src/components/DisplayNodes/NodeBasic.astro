---
import type { TimelineEntry } from '../../utils/inlineToTimeline'
import DynamicModalLink from '../DynamicModalLink.astro'
interface Props {
    entry: TimelineEntry
}
const { entry } = Astro.props

let Commentary 
if (entry.InlineProperties?.[0]?.Commentary) {
Commentary = `<button class="commentary-button" popovertarget="commentary-${entry.Index}">?</button>
<div popover id="commentary-${entry.Index}" class="node-commentary-popover">
    ${entry.InlineProperties?.[0]?.Commentary}
</div>`
}

---
<style>
    .display-node.basic {
        --title-padding: 16px;
        display: flex;
    }
.display-node.basic .content{
    display: flex;
    flex-direction: column;
    
    position: relative;
    isolation: isolate;
    padding: var(--title-padding);
    border-radius: 6px;
    background: var(--primary-bg);
    transition-property: border-color;
    transition-duration: 800ms; 
    color: var(--text-color);
    margin-right: 16px;
}
.display-node.basic .name-link {
    display: flex;
    align-items: center;
    p {
        color: var(--text-color-important);
        font-weight: bold;
        font-size: 1.1em;
        text-decoration: none;
        }
    }
    .content-embed {
        font-size: .8em;
    }

.popover-buttons {
    padding-top: var(--title-padding);
}

@media only screen and (min-width: 640px) {
    .display-node.basic {    
        margin: 32px 0 ;
    }
    .content {
        max-width: 720px;
        overflow-x: hidden;
    }
}

@media only screen and (max-width: 640px) {
.display-node.basic {
        margin: 6px 0;
        grid-column: 2 / 5; 
        font-size: 1.15em;
        border-width: 0px;
        paddng: 4px;
        max-width: 100%;   
        width: 100%;
        min-width: 10px;
        .name-link {
            margin-bottom: 8px;
        }
        .content-embed {
            font-size: .9em;
        }
    }
}  
    .popover-buttons {
        flex-direction: column;
    }

</style>
<div class="display-node basic">
    <div class="content">
        <div class="name-link">
            <p>{entry.EntryName}</p>
        </div>
        <div class="content-embed">{entry.InlineProperties?.[0].PriorLine}</div>
    </div>
    <div class="popover-buttons">
        <DynamicModalLink targetUrl={entry.InlineProperties?.[0].SourceLink} paywalled={entry.InlineProperties?.[0].Frontmatter?.Paywalled}/>
        <Fragment set:html={Commentary}/>
    </div>
</div>
