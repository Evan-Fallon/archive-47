---
import { Marked } from "marked";
const { atom } = Astro.props

const output = await new Marked().parse(atom.Content)
const output2 = output.replace(/!\[\[(.*?)\]\]/g, '<img src="images/$1"/>');
let Commentary = `
<button class="commentary-button" popovertarget="commentary-${atom.Index}"> ? </button>
<div popover id="commentary-${atom.Index}" class="node-commentary-popover">
    ${atom?.Commentary}
</div>
`
---

<style>


/* CONTAINERS */

.display-node.twitter {
    --twitter-border: rgb(47, 51, 54);
    margin: 16px 0;
    color: white;
}
.twitter.embed {
    zoom: .8;
    font-family: ;
    max-width: 600px;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    background: black;
    border-radius: 6px;
    --title-padding: 24px;
    box-sizing: border-box;
    padding: var(--title-padding);
    position: relative;
    font-family: TwitterChirp, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    > * {
        z-index: 2;
    }


}
.twitter.embed :global(p) {
    font-family: TwitterChirp, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    margin: 16px 0px;
}


/* NAME LINK */

.name-link {
    max-width: 510px;
    a {
        font-weight: bold;
        font-size: .9em;
        text-decoration: none;
        color: var(--text-color);
        
    }
}


/* HEADER */

.twitter.header {
    display: grid;
    grid-template-columns: 1fr 1fr;
}
.twitter.logo {
    justify-self: right;
    max-height: 42px;
    width: auto;
    justify-self: right;
    padding: 4px;
}
.twitter.user-info {
    display: grid;
    grid-template-rows: 24px 24px;
    grid-template-columns: min-content auto;
    p {
        margin: 0;
    }
}
.twitter.fullname {
    font-weight: bold;
    font-size: 15px;
}
.twitter.handle {
    color: grey;
    font-size: 15px;
}
img.twitter.user-icon {
    grid-row: 1 / 3;
    display: block;
    width: 40px;
    height:40px;
    border-radius: 100px;
    margin: 0 12px 0 0;
}


/* MEDIA */

.twitter.embed :global(blockquote.img-grid) { 
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    place-items: center;
    margin: 24px 0 0px 0;
    width: auto;
    height: auto;
    box-sizing: border-box;
    border-radius: 16px;
    gap: 6px;
    img {
        width: 100%;
        height: 100%;
        display: unset;
        aspect-ratio: 564 / 317;
        object-fit: cover;
        border: 1px solid var(--twitter-border);
        border-radius:8px;
    }
}
.twitter.content :global(img)  {
    width: 100%;
    border: 1px solid var(--twitter-border);
    border-radius: 8px;
}
.twitter.source-link {
    display: block;
    width: 100%;
    height: 42px;
    background: rgb(179, 179, 179);
    border-radius: 64px;
    text-align: center;
    align-content: center;
    a {
        display: block;
        align-content: center;
        color: black;
        width: 100%;
        height: 100%;
        margin: auto;
        text-decoration: none;
        font-weight: bold;
    }
}

/* FOOTER */

.twitter.footer {
    display: flex;
    margin: 0px 0 12px 0;;
    p {
        margin: 0 1rem 0 0;
        color: grey;
        b {
            color: white;
        }
    }
}
.twitter.date {
    text-align: end;
}
@media only screen and (min-width: 640px) {

}
@media only screen and (max-width: 640px) {

    .display-node.twitter {
        grid-column: 2 / 5;
        padding-left: 16px;
        .twitter.content :global(p) {
            font-size: 1.2rem;
        }
        .twitter.embed {
            padding: 0;
        }
        .twitter.footer {
            display: none;
        }
    }
    .twitter.content :global(p) {
            
}
}

</style>
<div class="display-node twitter">
    <div class="name-link">
        <a href={atom.URL}>{atom.Name}</a> {atom?.Commentary ? <Fragment set:html={Commentary}/> : ''}
    </div>
    <div class="twitter embed">
        <div class="twitter header">
            <div class="twitter user-info">
                <img src={`images/${atom.Frontmatter.Icon.slice(2, -2)}`} class="twitter user-icon"/>
                <p class="twitter fullname">{atom.Frontmatter["User Fullname"]}</p>
                <p class="twitter handle">{atom.Frontmatter["Handle"]}</p>
            </div>
            <img src="images/twitter-logo.png" class="twitter logo"/>  
        </div>
        <span class="twitter content" set:html={output2}/>
        <div class="twitter footer">
            <p class="twitter date">{atom.Frontmatter.Date}</p>
            <p class="twitter views"><b>{atom.Frontmatter.Views}</b> views</p>
        </div>
        <div class="twitter source-link">
            <a href={atom.URL}>See original on x.com</a>
        </div>
    </div>
</div>