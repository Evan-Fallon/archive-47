---
import { Marked } from 'marked'
const { atom } = Astro.props

let Commentary = `
<button class="commentary-button" popovertarget="commentary-${atom.Index}"> ? </button>
<div popover id="commentary-${atom.Index}" class="node-commentary-popover">
    ${atom?.Commentary}
</div>
`

let output = atom.Content.replace(/%%[\s\S]*?%%/g, '').trim();
output = output.replace(/!\[\[(.*?)\]\]/g, '<img src="images/$1"/>');
const calloutRegex = /^>\s*\[!([\w-]+)\]\r?\n((?:^>.*(?:\r?\n|$))+)/gm;
output = output.replace(calloutRegex, (_match: string, type: string, body: string) => {
    const unquotedBody = body
        .split(/\r?\n/)
        .map((line) => line.replace(/^>\s?/, ''))
        .join('\n')
        .trim();
        let parsedInner = new Marked().parse(unquotedBody, { async: false }) as string
        if (type === 'img-grid') {
            parsedInner = parsedInner.replace(/<p>\s*(<img[^>]+>)\s*<\/p>/g, '$1 ');
        }
        return `<blockquote class="${type}">\n${parsedInner.trim()}\n</blockquote>\n\n`;
  });

  console.log(output)
---
<style>
.display-node.twitter {
    --twitter-border: rgb(47, 51, 54);
    margin: 16px 0;
    
    transition-property: border-color;
    transition-duration: 800ms; 
    color: white;
    
    .name-link {
        a {
            font-weight: bold;
            font-size: 1.1em;
            text-decoration: none;
            color: var(--text-color-important);
        }

    }
    .twitter-embed {
        zoom: .85;
        max-width: 600px;
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        font-family: Roboto !important;
        background: black;
        border: 1px solid var(--border-basic);
        border-radius: 6px;
        --title-padding: 16px;
        box-sizing: border-box;
        padding: var(--title-padding);
       
    }
    .twitter-embed > img {
        display: none !important;
    }
    blockquote.img-grid { 
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        place-items: center;
        margin: 24px 0 24px 0;
        width: auto;
        
        height: auto;
        box-sizing: border-box;
        border-radius: 16px;
        gap: 6px;
        box-sizing:;
        img {
            width: 100%;
            height: 100%;
            display: unset;
            aspect-ratio: 564 / 317;
            object-fit: cover;
            border: 1px solid var(--twitter-border);
            border-radius:8px;
        }
    }
    blockquote.user-info {
        display: contents;
        * {
            display: contents;
            margin: 0;
        }
        .list-bullet {
            display: none;
        }
        .callout-title {
            display: none;
        }
        
        ul {
            display: grid;
            grid-template-columns: 48px 1fr;
            grid-template-rows: 50% 50%;
            align-items: center;
            height: 40px;
            margin: 0px 0 20px 0;
            padding: 0;
            img {
                grid-row: 1 / 3;
                display: unset;
                border-radius: 100%;
                height: 40px;
            }
            li a {
                display: unset;
                grid-column: 2 / 3;
                text-decoration: none;
                color: var(--text-normal);
                font-size: 15px;
                background-image: none;
            }
            li:nth-child(2) a {
                font-weight: bold;
            }
            li:nth-child(3) a {
                color: light-dark(rgb(83, 100, 113), rgb(113, 118, 123));
                pointer-events: none;
            }
        }
    }
    blockquote.twitter-metadata {
        color: grey;
        margin: 10px 0 0 0;
        padding: 0;
    }
}


@media only screen and (max-width: 640px) {
.display-node {    
        grid-column: 2 / 5; 
        font-size: 1.15em;
        border-width: 0px;
        paddng: 4px;
        max-width: 100%;   
        width: 100%;
        min-width: 10px;
        &:hover {
            border-width: 0px;
        }
        .content-embed {
            font-size: 1em;
        }
    }
} 


</style>
<div class="display-node twitter">
<p></p>
    <div class="name-link">
    <a href=${atom.URL}>{atom.Name}</a> {atom?.Commentary ? <Fragment set:html={Commentary}/> : ''}
    </div>
    <div class="twitter-embed" set:html={output}/>
</div>