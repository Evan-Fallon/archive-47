---

import DynamicModalLink from '../DynamicModalLink.astro'

const { atom } = Astro.props

let Commentary 
if (atom.Commentary) {
Commentary = `<button class="commentary-button" popovertarget="commentary-${atom.Index}">?</button>
<div popover id="commentary-${atom.Index}" class="node-commentary-popover">
    ${atom?.Commentary}
</div>`
}

let PriorLine = `
<button class="content-button" popovertarget="content-${atom.Index}">"</button>
<div popover id="content-${atom.Index}" class="node-content-popover">
    ${atom?.StrippedLine}
</div>
`
---
<style>
.display-node.minor {
    margin: 16px 0;
    --title-padding: 16px;
    margin: 10px 0;
    display: flex;
    align-items: center;
    .name-link {   
        height: fit-content;
        width: fit-content;
        p { 
        font-weight: bold;
        font-size: .85em;
        text-decoration: none;
        color: var(--text-color);
        text-box-trim: trim-both;
        text-box-edge: ex alphabetic;
        }
    }
}

@media only screen and (max-width: 640px) {
    .display-node.minor  {
        width: 100%;
        font-size: 1em;
        border-width: 0px;
    }
}

</style>
<div class="display-node minor">
    <div class="name-link">
        <p>{atom.Name}</p> 
    </div>
    <div class="popover-buttons">
        <Fragment set:html={Commentary}/>
        <DynamicModalLink targetUrl={atom.SourceLink} paywalled={atom.Frontmatter?.Paywalled}/>
        
    </div>
</div>