---

import type { TimelineEntry } from '../../utils/inlineToTimeline'
import DynamicModalLink from '../DynamicModalLink.astro'

interface Props {
    entry: TimelineEntry;
}
const { entry } = Astro.props

let PriorLine = `
<button class="content-button" popovertarget="content-${entry.Index}">"</button>
<div popover id="content-${entry.Index}" class="node-content-popover">
    ${entry.Properties.StrippedLine}
</div>
`
---
<style>
.display-node.minor {
    margin: 8px 0 8px var(--title-padding);
    display: flex;
    align-items: center;
    .name-link {   
        height: fit-content;
        width: fit-content;
        p { 
        font-weight: bold;
        font-size: .85em;
        text-decoration: none;
        color: var(--text-color);
        text-box-trim: trim-both;
        text-box-edge: ex alphabetic;
        text-wrap: balance;
        }
    }
}

@media only screen and (max-width: 640px) {
    .display-node.minor  {
        width: 100%;
        font-size: 1em;
        border-width: 0px;
    }
}

</style>
<div class="display-node minor">
    <div class="name-link">
        <p>{entry.EntryName}</p> 
    </div>
</div>