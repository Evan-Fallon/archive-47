---
import type { TimelineEntry } from '../../utils/inlineToTimeline'


interface Props {
    entry: TimelineEntry;
}

const { entry } = Astro.props

let seconds = 0

if (entry.Properties?.Timestamp) {
seconds = Number(entry.Properties.Timestamp.split(":")[0]) * 60 + Number(entry.Properties.Timestamp.split(":")[1])
}
---
<style>
.display-node.youtube {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 720px;
    padding: var(--title-padding);
    background: var(--primary-bg);
    gap: 8px;
    border-radius: 8px;
}

.display-node.youtube .name-link  p {
    text-wrap: balance;
    color: var(--text-color-important);
    font-weight: bold;
    font-size: 1em;
    text-decoration: none;
    }
.display-node.youtube .youtube-video {
    width: 100%;
}
.display-node.youtube .youtube-video iframe {
    min-width: 320px;
    max-width: unset;
    width: 100%;
}

@media only screen and (min-width: 640px) {
    .display-node.youtube {    
        margin: 32px 0 ;
    }
    .content {
        max-width: 720px;
        overflow-x: hidden;
    }
}

@media only screen and (max-width: 640px) {
.display-node.youtube {
        margin: 6px 0;
        grid-column: 2 / 3; 
        font-size: 1.15em;
        border-width: 0px;
        paddng: 4px;
        max-width: 100%;   
        width: 100%;
        min-width: 10px;
        .name-link {
            margin-bottom: 8px;
        }
        .content-embed {
            font-size: .9em;
        }
    }
}  
.youtube-video iframe {
    max-width: 540px;
    width: 70vw;
    max-height: 380px;
    aspect-ratio: 16 / 9;
}

</style>
<div class="display-node youtube">
    <div class="name-link">
        <p>{entry.EntryName}</p>
    </div>
    <div class="youtube-video">
        <iframe src={`${entry.Properties.Frontmatter.EmbedURL}?start=${seconds}`} title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
</div>
