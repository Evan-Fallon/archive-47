---
import { Marked } from 'marked'
const { atom } = Astro.props

let Commentary = `
<button class="commentary-button" popovertarget="commentary-${atom.Index}"> ? </button>
<div popover id="commentary-${atom.Index}" class="node-commentary-popover">
    ${atom?.Commentary}
</div>
`

let output = atom.Content.replace(/%%[\s\S]*?%%/g, '').trim();
output = output.replace(/!\[\[(.*?)\]\]/g, '<img src="images/$1"/>');
const calloutRegex = /^>\s*\[!([\w-]+)\]\r?\n((?:^>.*(?:\r?\n|$))+)/gm;
output = output.replace(calloutRegex, (_match: string, type: string, body: string) => {
    const unquotedBody = body
        .split(/\r?\n/)
        .map((line) => line.replace(/^>\s?/, ''))
        .join('\n')
        .trim();
        let parsedInner = new Marked().parse(unquotedBody, { async: false }) as string
        if (type === 'img-grid') {
            parsedInner = parsedInner.replace(/<p>\s*(<img[^>]+>)\s*<\/p>/g, '$1 ');
        }
        return `<blockquote class="${type}">\n${parsedInner.trim()}\n</blockquote>\n\n`;
  });

---
<style>
.display-node.truth {
    --twitter-border: rgb(47, 51, 54);
    margin: 16px 0;
    transition-property: border-color;
    transition-duration: 800ms; 
    color: black;
    .truth-content {
        font-family: Inter;
    }
    .name-link {
        a {
            font-weight: bold;
            font-size: 1.1em;
            text-decoration: none;
            color: var(--text-color);
        }
    }
    .truth-embed {
        zoom: .85;
        max-width: 600px;
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        background: white;
        border: 1px solid var(--border-basic);
        border-radius: 6px;
        --title-padding: 24px;
        box-sizing: border-box;
        padding: var(--title-padding);
    }
    blockquote.img-grid { 
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        place-items: center;
        margin: 24px 0 24px 0;
        width: auto;
        height: auto;
        box-sizing: border-box;
        border-radius: 16px;
        gap: 6px;
        img {
            width: 100%;
            height: 100%;
            display: unset;
            aspect-ratio: 564 / 317;
            object-fit: cover;
            border: 1px solid var(--twitter-border);
            border-radius:8px;
        }
    }
    blockquote.user-info {
        display: contents;
        * {
            display: contents;
            margin: 0;
        }
        .list-bullet {
            display: none;
        }
        .callout-title {
            display: none;
        }
        ul {
            display: grid;
            grid-template-columns: 48px 1fr;
            grid-template-rows: 50% 50%;
            align-items: center;
            height: 40px;
            margin: 0px 0 20px 0;
            padding: 0;
            img {
                grid-row: 1 / 3;
                display: unset;
                border-radius: 100%;
                height: 40px;
            }
                li {
                    margin: 0px;
                    padding: 0px;
                    display: block;
                    list-style-type: none;
                    font-size: 14px;
                    &:has(img) {
                        grid-column: 1 / 2;
                        grid-row: 1 / 3;

                        img {
                            display: block;
                            width: 42px;
                            height:42px;
                            border-radius: 100px;
                        }
                    }
                    &:has(strong) {
                                            padding-left: 8px;
                        grid-column: 2 / 3;
                        grid-row: 1 / 2
                    }
                    &:has(em) {
                                            padding-left: 8px;
                        grid-column: 2 / 3;
                        grid-row: 2 / 3;
                        em { font-style: normal;
                    }
                    }
                }
        }
    }
    blockquote.truth-metadata {
        background: none;
        border: none;
        margin: 0;
        padding: 0;

        .callout-title,
        .list-bullet {
            display: none;
        }

        .callout-content {
            margin: 0px;
        }

        ul {
            padding: 0;
            margin: 0px;
            display: grid;
            grid-template-columns: 128px 1fr 1fr;
            grid-template-rows: 1fr 1fr;
        }

        li {
            margin: 0px;
            color: rgb(101, 97, 117);
            font-size: 16px;
            list-style-type: none;

            strong {
                color: black;
            }

            &:nth-child(3) {
                justify-self: right;
            }

            /* Footer link behavior */
            &:nth-child(4) {
                grid-column: 1 / 4;
                width: 100%;
                border: 2px solid rgb(237, 237, 239);
                height: 40px;
                border-radius: 40px;
                text-align: center;
                align-content: center;
                display: var(--ts-li4-display);

                a {
                    display: block;
                    color: rgb(134, 131, 147);
                    background-image: none;

                    &:hover {
                        color: rgb(87, 85, 95);
                        text-decoration: none;
                    }
                }
            }
        }
    }
}


@media only screen and (max-width: 640px) {
.display-node.truth {    
        grid-column: 2 / 5; 
        margin: 0;
        font-size: 1.15em;
        border-width: 0px;
        padding: 4px;
        max-width: 100%;   
        width: 100%;
        min-width: 0%;
        padding: 0;
        &:hover {
            border-width: 0px;
        }
    .name-link {
        padding-left: 0px;
        padding-bottom: 16px;
        padding-top: 16px;
        display: flex;
        a {
            font-weight: bold;
            font-size: .9rem;
            line-height: 1;
            
        }
    }
        .truth-embed { 
            font-size: 1em;
            padding-left: 0px;
            border: none;
            margin: 0 24px 0 0;
            border-radius: 0;
            blockquote.img-grid {
                margin: 24px 0 0px 0;
            }
        }
    }
    
} 
img.truth-icon {
    display: block;
    width: 42px;
    height:42px;
    border-radius: 100px;
}
img.truth-logo {
        height: 24px;
        width: auto;
        justify-self: right;
        padding: 4px;
    }
.truth-social.metadata {
    display: flex;
    margin: 8px 0;
}
.truth-social.header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    margin-bottom: 8px;

}
.truth-social.user-info {
    display: grid;
    grid-template-columns: 48px auto;
    grid-template-rows: 24px 24px;
    .truth-icon {
        grid-row: 1 / 3;
    }
    .fullname {
        font-weight: bold;
    }
}
.source-link {
    padding: 10px;
    border: 1px solid grey;
    border-radius: 64px;
    text-align: center;
    &:hover {
        color: rgb(87, 85, 95);
        text-decoration: none;
    }
}

</style>

<div class="display-node truth">
    <div class="name-link">
    <a href=${atom.URL}>{atom.Name}</a> {atom?.Commentary ? <Fragment set:html={Commentary}/> : ''}
    </div>
    <div class="truth-embed">
        <div class="truth-social header">
            <div class="truth-social user-info">
                <img src={`images/${atom.PageProperties.Icon.slice(2, -2)}`} class="truth-icon"/>
                <p class="truth-social fullname">{atom.PageProperties["User Fullname"]}</p>
                <p class="truth-social handle">{atom.PageProperties["Handle"]}</p>
            </div>
            <img src="images/Truth_Social_logo_2022-light.png" class="truth-logo"/>
            
        </div>
        <div class="truth-content" set:html={output}/>
        <div class="truth-social metadata">
            <p class="truth-social views"><b>{atom.PageProperties.ReTruths}</b> ReTruths</p>
            <p class="truth-social views"><b>{atom.PageProperties.Likes}</b> Likes</p>
            <p class="truth-social date">{atom.PageProperties.Date}</p>   
        </div>
        <div class="source-link">
            <a href={atom.URL}>See original on Truthsocial.com</a>
        </div>
    </div>
</div>