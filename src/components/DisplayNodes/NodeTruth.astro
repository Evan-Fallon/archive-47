---
import { Marked } from "marked";
import { Temporal } from "@js-temporal/polyfill";
import type { TimelineEntry } from "../../utils/inlineToTimeline";


interface Props {
    entry: TimelineEntry;
}
const { entry } = Astro.props

const output = await new Marked().parse(entry.Properties.Content)
const output2 = output.replace(/!\[\[(.*?)\]\]/g, '<img src="images/$1"/>');

let Commentary 
if (entry.Properties?.Commentary) {
Commentary = `<button class="commentary-button" popovertarget="commentary-${entry.Index}">?</button>
<div popover id="commentary-${entry.Index}" class="node-commentary-popover">
    ${entry.Properties?.Commentary}
</div>`
}
---

<style>


/* CONTAINERS */

.display-node.truth {
    --truth-border: rgb(47, 51, 54);
    margin: 16px 0;
    color: black;
}
.truth.embed {
    zoom: .8;
    max-width: 720px;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    background: rgb(230, 230, 230);
    border-radius: 6px;
    --title-padding: 24px;
    box-sizing: border-box;
    padding: var(--title-padding);
    position: relative;

}
.truth.embed .truth.content :global(p) {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, Noto Sans, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji;
    font-size: 18px;
    line-height: 28px;
    margin: 16px 0px;
}


/* NAME LINK */

.name-link {
    max-width: 510px;
    p {
        font-weight: bold;
        font-size: .9em;
        text-decoration: none;
        color: var(--text-color);
        
    }
}


/* HEADER */

.truth.header {
    display: grid;
    grid-template-columns: 1fr 1fr;
}
.truth.logo {
    justify-self: right;
    max-height: 32px;
    width: auto;
    justify-self: right;
    padding: 4px;
}
.truth.user-info {
    display: grid;
    grid-template-rows: 24px 24px;
    grid-template-columns: min-content auto;
    p {
        margin: 0;
    }
}
.truth.fullname {
    font-weight: bold;
    font-size: 1.1em;
}
.truth.handle {
    color: grey;
}
img.truth.user-icon {
    grid-row: 1 / 3;
    display: block;
    width: 48px;
    height:48px;
    border-radius: 100px;
    margin: 0 12px 0 0;
}


/* MEDIA */

.truth.embed :global(blockquote.img-grid) { 
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    place-items: center;
    margin: 24px 0 24px 0;
    width: auto;
    height: auto;
    box-sizing: border-box;
    border-radius: 16px;
    gap: 6px;
    img {
        width: 100%;
        height: 100%;
        display: unset;
        aspect-ratio: 564 / 317;
        object-fit: cover;
        border-radius:8px;
    }
}
.truth.content :global(img)  {
    width: 100%;
    border-radius: 8px;
}


/* FOOTER */

.truth.footer {
    display: flex;
    margin: 0px 0 12px 0;
    color: dimgrey;
    p {
        margin: 0 1rem 0 0;
        b {
            color: black;
        }
    }
}
.truth.footer .truth.date {
    margin-left: auto;
    margin-right: 0;
    color: dimgrey;
}
.truth.source-link {
    display: block;
    width: 100%;
    height: 42px;
    border: 1px solid silver;
    border-radius: 64px;
    text-align: center;
    align-content: center;
    a {
        display: block;
        text-decoration: none;
        font-weight: bold;
        align-content: center;
        color: grey;
        width: 100%;
        height: 100%;
        margin: auto;
    }
}

@media only screen and (min-width: 640px) {
}
@media only screen and (max-width: 640px) {
    :global(.timeline-cell:has(.display-node.truth)) {
        background: rgb(246, 246, 246) !important;
    }
    .display-node.truth {
        grid-column: 2 / 5;
        .truth.embed {
            padding: 0;
            background: none;
        }
        .truth.content :global(p) {
            font-size: 1.2rem;
        }
        .name-link a {
            color: black;
        }
    }
    .truth.footer {
        display: none;
    }
    .truth.logo {
        padding: 0;
        max-height: 24px;
    }
}


</style>
<div class="display-node truth">
    <div class="name-link">
        <p>{entry.EntryName}</p> 
        <div class="popover-buttons">
            <Fragment set:html={Commentary}/>
        </div>
    </div>
    <div class="truth embed">
        <div class="truth header">
            <div class="truth user-info">
                <img src={`images/${entry.Properties.Frontmatter.Icon.slice(2, -2)}`} class="truth user-icon"/>
                <p class="truth fullname">{entry.Properties.Frontmatter["User Fullname"]}</p>
                <p class="truth handle">{entry.Properties.Frontmatter["Handle"]}</p>
            </div>
            <img src="images/Truth_Social_logo_2022-light.png" class="truth logo"/>  
        </div>
        <span class="truth content" set:html={output2}/>
        <div class="truth footer">
            <p class="truth truths"><b>{entry.Properties.Frontmatter.ReTruths}</b> ReTruths </p>
            <p class="truth views"><b>{entry.Properties.Frontmatter.Likes}</b> Likes</p>
            <p class="truth date">{entry.Properties.toLocaleString()}</p>
        </div>
        <div class="truth source-link">
            <a href={entry.Properties.Frontmatter.URL}>See original on truthsocial.com</a>
        </div>
    </div>
</div>