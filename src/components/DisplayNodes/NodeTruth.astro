---
import { Marked } from "marked";
const { atom } = Astro.props

const output = await new Marked().parse(atom.Content)
const output2 = output.replace(/!\[\[(.*?)\]\]/g, '<img src="images/$1"/>');
let Commentary = `
<button class="commentary-button" popovertarget="commentary-${atom.Index}"> ? </button>
<div popover id="commentary-${atom.Index}" class="node-commentary-popover">
    ${atom?.Commentary}
</div>
`
---

<style>


/* CONTAINERS */

.display-node.truth {
    --truth-border: rgb(47, 51, 54);
    margin: 16px 0;
    color: black;
}
.truth.embed {
    zoom: .85;
    max-width: 600px;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 6px;
    --title-padding: 24px;
    box-sizing: border-box;
    padding: var(--title-padding);
    position: relative;

}
.truth.embed :global(p) {
    font-family: Mozilla, sans-serif;
    margin: 16px 0px;
}


/* NAME LINK */

.name-link {
    max-width: 510px;
    a {
        font-weight: bold;
        font-size: .9em;
        text-decoration: none;
        color: var(--text-color);
        
    }
}


/* HEADER */

.truth.header {
    display: grid;
    grid-template-columns: 1fr 1fr;
}
.truth.logo {
    justify-self: right;
    height: 24px;
    width: auto;
    justify-self: right;
    padding: 4px;
}
.truth.user-info {
    display: grid;
    grid-template-rows: 24px 24px;
    grid-template-columns: min-content auto;
    p {
        margin: 0;
    }
}
.truth.fullname {
    font-weight: bold;
    font-size: 1.1em;
}
.truth.handle {
    color: grey;
}
img.truth.user-icon {
    grid-row: 1 / 3;
    display: block;
    width: 48px;
    height:48px;
    border-radius: 100px;
    margin: 0 12px 0 0;
}


/* MEDIA */

.truth.embed :global(blockquote.img-grid) { 
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    place-items: center;
    margin: 24px 0 24px 0;
    width: auto;
    height: auto;
    box-sizing: border-box;
    border-radius: 16px;
    gap: 6px;
    img {
        width: 100%;
        height: 100%;
        display: unset;
        aspect-ratio: 564 / 317;
        object-fit: cover;
        border-radius:8px;
    }
}
.truth.content :global(img)  {
    width: 100%;
    border-radius: 8px;
}


/* FOOTER */

.truth.footer {
    display: flex;
    margin: 0px;
    p {
        margin: 0 1rem 0 0;
        color: grey;
    }
}
.truth.date {
    text-align: end;
}
.truth.source-link {
    display: block;
    width: 100%;
    height: 42px;
    border: 1px solid grey;
    border-radius: 64px;
    text-align: center;
    align-content: center;
    a {
        color: black;
        width: 100%;
        height: 100%;
        margin: auto;
    }
}

@media only screen and (min-width: 640px) {
    .truth.embed {
        > * {
            z-index: 2;
        }

        &::after {
            content: '';
            position: absolute;
            inset: 0 0 0 0;
            background: white;
            border-radius: 6px;
        }
        &::before {
            content: '';
            position: absolute;
            inset: 0 0 0 0;
            transition-duration: 200ms;
            border-radius: 8px;
        }
        &:hover::before {
            background: #6f64f1;
            inset: 0 -16px 0 0;
        }
    }
}
@media only screen and (max-width: 640px) {

    .display-node.truth {
        grid-column: 2 / 5;
        .truth.embed {
            padding: 0;
        }
        .truth.content :global(p) {
            font-size: 1.2rem;
        }
        .name-link a {
            color: black;
        }
    }
    .truth.footer {
        display: none;
    }
    .truth.source-link {
        display: none;
    }
}


</style>
<div class="display-node truth">
    <div class="name-link">
        <a href={atom.URL}>{atom.Name}</a> {atom?.Commentary ? <Fragment set:html={Commentary}/> : ''}
    </div>
    <div class="truth embed">
        <div class="truth header">
            <div class="truth user-info">
                <img src={`images/${atom.Frontmatter.Icon.slice(2, -2)}`} class="truth user-icon"/>
                <p class="truth fullname">{atom.Frontmatter["User Fullname"]}</p>
                <p class="truth handle">{atom.Frontmatter["Handle"]}</p>
            </div>
            <img src="images/Truth_Social_logo_2022-light.png" class="truth logo"/>  
        </div>
        <span class="truth content" set:html={output2}/>
        <div class="truth footer">
            <p class="truth truths">{atom.Frontmatter.ReTruths} ReTruths</p>
            <p class="truth views">{atom.Frontmatter.Likes} Likes</p>
            <p class="truth date">{atom.Frontmatter.Date}</p>
        </div>
        <div class="truth source-link">
            <a href={atom.URL}>See original on truthsocial.com</a>
        </div>
    </div>
</div>