---
import type { TimelineEntry } from "../../utils/inlineToTimeline"

interface Props {
    entry: TimelineEntry;
}

const { entry } = Astro.props


let seconds = 0

if (entry.Properties?.Timestamp) {
seconds = Number(entry.Properties.Timestamp.split(":")[0]) * 60 + Number(entry.Properties.Timestamp.split(":")[1])
}



---
<style>
.display-node.youtube-group {
    display: flex;        
    border-radius: 8px;
    width: 100%;
    padding-top: 16px;
}
.display-node.youtube-group .entry-name {
    display: flex;
    font-weight: bold;
    color: var(--text-color-important);
    margin-left: 0px;
}
.display-node.youtube-group .content{
    display: flex;
    max-width: 720px;
    width: 100%;
    flex-direction: column;
    gap: 8px;
    --title-padding: 16px;
    position: relative;
    isolation: isolate;
    padding:  var(--title-padding);
    border-radius: 6px;
    transition-property: border-color;
    transition-duration: 800ms; 
    color: var(--text-color);
    background: var(--primary-bg);
}
.display-node.youtube-group .timestamp-list {
    display: flex;
    flex-direction: column;
    align-items: start;
    overflow: hidden;
    max-height: 35px;
    transition: max-height 1000ms ease;
    background: var(--secondary-bg);
    border-color: var(--border-basic);
    border-width: 1px;
    border-style: solid;
    border-radius: 8px;
    padding: 4px 8px;
    &:hover {
        max-height: 40px;
    }
    &:focus {
        max-height: 500px;
        overflow: auto;
    }
}
.display-node.youtube-group .timestamp-list p {
        color: var(--text-color-important);
        font-size: .9em;
        text-decoration: none;
        color: var(--text-color);
        }
    .content-embed {
        font-size: .8em;
    }


@media only screen and (min-width: 640px) {
    .display-node.basic {    
        margin: 32px 0 ;
    }
    .content {
        max-width: 720px;
        overflow-x: hidden;
    }
}

@media only screen and (max-width: 640px) {
.display-node.youtube-group {
        margin: 6px 0;
        grid-column: 2 / 3; 
        font-size: 1.15em;
        border-width: 0px;
        paddng: 4px;
        max-width: 100%;   
        width: 100%;
        min-width: 10px;
        .name-link {
            margin-bottom: 8px;
        }
        .content-embed {
            font-size: .9em;
        }
    }
}  
.youtube-group .youtube-video iframe {
    max-width: 720px;
    width: 100%;
    max-height: unset;
    aspect-ratio: 16 / 9;
}

</style>
<div class="display-node youtube-group">
    
    
    <div class="content">
        <p class="entry-name">
        {entry.EntryName}
        
    </p> 
        <div class="youtube-group youtube-video">
            <iframe src={`${entry.Properties.Frontmatter.EmbedURL}?start=${seconds}`} title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <div class="timestamp-list" tabindex="0">
            {entry?.Children?.map(x => {
                return (
                    <p>
                        { x?.Timestamp } - {x.Name}
                    </p>
                )
            })}
        </div>
    </div>
</div>
