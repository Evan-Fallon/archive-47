---
import type { TimelineEntry } from '../../utils/inlineToTimeline'
import DynamicModalLink from '../DynamicModalLink.astro'

interface Props {
    entry: TimelineEntry
}

const { entry } = Astro.props

let Commentary 
if (entry.Properties?.Commentary) {
Commentary = `<button class="commentary-button" popovertarget="commentary-${entry.Index}">?</button>
<div popover id="commentary-${entry.Index}" class="node-commentary-popover">
    ${entry.Properties.Commentary}
</div>`
}

---
<style>
.display-node.image {
        display: grid;
        max-height: 225px;
        border-radius: 0px;
        overflow: hidden;
        grid-template-areas: "pile";
        box-sizing: border-box;
        transition-property: border-color;
        transition-duration: 800ms; 
        > * {
            grid-area: pile;
        }
        .name-link {
            display: flex;
            gap: .5em;
            align-items: center;
            height: fit-content;
            width: fit-content;
            max-width: 80%;
            background: hsl(from var(--primary-bg) h s l / .9);
            padding: 8px 24px;
            border-radius: 0 0 12px 0;
            z-index: 1;
            p {
                text-box-trim: trim-both;
                text-box-edge: cap alphabetic;
                font-weight: bold;
                font-size: 1em;
                text-decoration: none;
                color: var(--text-color-important);
            }
        }

        img {
            width: 100%;
            height: 100%;
            min-height: 200px;
            object-fit: cover;
            object-position: center;
        }
    }
    .content-embed {
        font-size: 1em;
        padding: 8px 0 0 0;
    }
.popover-buttons {
    height: 50px;
    place-items: center;
    button {
        background: hsl(0 0 0 / 1);
        color: dimgray;
        svg {
            color: dimgray;
        }
    }
}

@media only screen and (max-width: 640px) {
.display-node.image {
            grid-column: 1 / 5; 
            grid-row: 1 / 2;
            grid-template-columns: subgrid;
            margin: 0;
            border: none !important;
            .name-link {
                width: fit-content;
                grid-column: 1 / 5;
                grid-row: 1 / 2;
                border-radius: 0;
                padding: 12px 28px 12px 28px;
                border-radius: 0 0 8px 0px;
                p {
                font-size: .9rem;
                }
            }
            .popover-buttons {
                grid-column: 2 / 5;
                grid-row: 1 / 2;
            }
            img {
                grid-column: 1 / 5 !important;
                width: 100%;
            }
            .image-node-day {
                display: none;
            }
        }
    }



</style>
<div class="display-node image">
        <img src={`images/${entry.Properties["Display Image"]}`}/>
    <div class="name-link">
       <p><span class="image-node-day">{entry.Properties.OrdinalDay} {entry.Properties.DateString.split("T")[1] ? " - " + entry.Properties.DateString.split("T")[1] : ""} - </span>{entry.EntryName}</p>   
     </div>
       <div class="popover-buttons"> 
        <Fragment set:html={Commentary}/>
            <DynamicModalLink targetUrl={entry.Properties.SourceLink} paywalled={entry.Properties?.Paywalled}/>
            
   
    </div>  
</div>