---
import type { TimelineEntry } from '../../utils/inlineToTimeline'
import DynamicModalLink from '../DynamicModalLink.astro'

interface Props {
    entry: TimelineEntry
}

const { entry } = Astro.props

let Commentary 
if (entry.Properties?.Commentary) {
Commentary = `<button class="commentary-button" popovertarget="commentary-${entry.Index}">?</button>
<div popover id="commentary-${entry.Index}" class="node-commentary-popover">
    ${entry.Properties.Commentary}
</div>`
}

---
<style>
.display-node.image {
        display: grid;
        max-height: 225px;
        border-radius: 0px;
        overflow: hidden;
        grid-template-areas: "pile";
        box-sizing: border-box;
        transition-property: border-color;
        transition-duration: 800ms; 
        > * {
            grid-area: pile;
        }
        .name-link {
            display: flex;
            gap: .5em;
            align-items: center;
            height: fit-content;
            width: fit-content;
            max-width: 80%;
            background: hsl(from var(--primary-bg) h s l / .9);
            padding: 8px 16px;
            border-radius: 0 0 8px 8px ;
            z-index: 1;
            p {
                text-box-trim: trim-both;
                text-box-edge: cap alphabetic;
                font-weight: bold;
                font-size: 1em;
                text-decoration: none;
                color: var(--text-color-important);
            }
        }

        img {
            width: 100%;
            height: 100%;
            min-height: 200px;
            object-fit: cover;
            object-position: center;
        }
    }
    .content-embed {
        font-size: 1em;
        padding: 8px 0 0 0;
    }
.popover-buttons {
    height: 50px;
    place-items: center;
    button {
        background: hsl(0 0 0 / 1);
        color: dimgray;
        svg {
            color: dimgray;
        }
    }
}




</style>
<div class="display-node image">
        <img src={`images/${entry.Properties["Display Image"]}`}/>
    <div class="name-link">
       <p>{entry.EntryName}</p>   
    </div>
</div>