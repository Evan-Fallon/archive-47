---
import type { VaultNote } from '../utils/vaultQuery';
import { resolveVaultImage } from '../utils/copyVaultImages';

interface Props {
    series: VaultNote;
}
let resolvedImage
const { series } = Astro.props;
if (series.Frontmatter?.["A47-Image"]) {
    resolvedImage = resolveVaultImage(series.Frontmatter?.["A47-Image"])
}

---
<div class="series-node full">
<style>
    .series-node.full {
    display: grid;
    grid-template-columns: 1fr 2fr;
    height: 240px;
    width: 720px;
    background: var(--secondary-bg);
    border: 1px solid var(--border-basic);
    border-radius: 12px;
    overflow: hidden;
    margin-top: 64px;
    }
    .series-image {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    }
    .series-content {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    display: grid;
    grid-template-rows: 25px 1fr auto;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 16px;
    h3 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 2px;
        text-align: center;
    }
    }
    .series-description {
    display: flex;
    font-size: .75rem;
    justify-content: center;
    align-items: center;
    width: 100%;
    text-align: center;
    p {
        margin: 0;
        padding: 0 16px;
    }
    }
    .series-components {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    gap: 16px;
    overflow-x: auto;
    }
    .series-component {
    display: flex;
    justify-content: center;
    align-items: center;
    width: auto;
    height: 40px;
    background: var(--primary-bg);
    border: 1px solid var(--border-basic);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-normal);
    font-size: 1rem;
    padding: 8px;
    }
</style>
<div class="series-content">
    <h3>{series.BaseName}</h3>
    <div class="series-description">
    <p>
        {series.Frontmatter?.["A47-Description"] || ""}
    </p>
    </div>
    <div class="series-components">
    <a class="series-component" href=`./${series.BaseName.toLowerCase().replaceAll(" ", "-")}-timeline`>View Timeline</a>
    </div>
</div>
<div class="series-image">
    <img src={resolvedImage}/>
</div>
</div>