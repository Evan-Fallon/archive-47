---
import { FileLock, SquareText } from '@lucide/astro'

// DynamicTextLink.astro
interface Props {
  targetUrl: string; // E.g. "https://example.com/page#:~:text=specific%20phrase"
  buttonText?: string;
  paywalled?: boolean;
}

const { targetUrl, buttonText = "View Highlighted Text", paywalled } = Astro.props;

let Icon =  SquareText
if (paywalled) {
  Icon = FileLock
}

---
<style>
  .lucide {
    color: var(--primary-bg);
    stroke-width: 2px;
  }

</style>
<button type="button" class="popup-trigger" data-url={targetUrl}>
 <Icon/>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.popup-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const url = btn.dataset.url;
      if (!url) return;

      const width = 900;
      const height = 750;
      const left = window.screenX + (window.outerWidth - width) / 2;
      const top = window.screenY + (window.outerHeight - height) / 2;

      // Opens top-level window where #:~:text= is allowed
      window.open(
        url,
        'TextFragmentModal',
        `width=${width},height=${height},top=${top},left=${left},resizable=yes,scrollbars=yes`
      );
    });
  });
</script>