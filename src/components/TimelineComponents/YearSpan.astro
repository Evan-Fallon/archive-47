---
const { year, start, end } = Astro.props;
---
<style>
.timeline-cell.year.spacer {
    display:                block;
    height:                 55px;
    opacity:                1;
    grid-column:            1 / -1;

}
.timeline-range.year {
    grid-column:            1 / -1;
    width:                  100%;
    height:                 100%;
    align-items:            start;
    pointer-events:         none;
    text-align:             center;
    font-size:              2.5rem;
    pointer-events:         none;
    
}
.timeline-range.year .year.slider {
    display:                flex;
    height:                 55px;
    width:                  100%;
    justify-content:        center;
    align-items:            center;
    font-weight:            600;
    position:               sticky;
    top:                    0px;
    overflow-y:             visible;
    background:             light-dark(var(--color-accent), var(--primary-bg));
    z-index:                7;
}
@media only screen and (max-width: 640px) { 
    .timeline-range.year .slider.year {
        top: 50px;
    }
}
</style>

<div class="timeline-cell year spacer" style={`grid-row: ${start} / ${start + 1}`}/>
<div class="timeline-range year" style={`grid-row: ${start} / ${end + 1}`}>
    <span class="year slider">{year}</span>
</div>