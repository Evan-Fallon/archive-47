---
import { Temporal } from "@js-temporal/polyfill";

interface Props {
    ordinalDay: string;
    dateString: string;
    date: Temporal.PlainDateTime;
    displayClass: string;
    index: number;
}

const { ordinalDay, dateString, date, displayClass, index } = Astro.props;
const time = dateString?.includes("T") ? Temporal.PlainTime.from(dateString) : null;
---

<style is:global>
.node-day-time {
    font-size: 0.8rem;
    color: var(--text-color);
    place-self: center right;
    pointer-events: none;
    text-align: center;
    p {
        margin: 0px;
    }
    .node-day {
        font-weight: bold;
    }
    .node-time {
        font-size: .7rem;
    }
}

@media only screen and (max-width: 640px) { 
    .node-day-time {
        grid-column: 1 / 2 !important;
        font-size: 1em;
        display: flex; 
        flex-direction: column;
        background: hsl(from var(--primary-bg) h s l / .75);
        padding: 0 4px;
        margin-right: 4px;
        padding: 1px 6px;
        z-index: 4;
        p {
            padding: 0;
            height: auto;
            margin: 0;
        }
        .node-day {
            font-weight: bold;
        }
        .node-time {
            font-size: .7rem;
        }
        &.Minor {
            background: var(--secondary-bg);
        }
    }
}
</style>

<div class={`node-day-time ${displayClass}`} 
style={`
    grid-column: 2 / 3;
    grid-row: ${index} / ${index + 1};
    --anim-delay: ${index * 125}ms`
}>
    <p class="node-day">{ordinalDay}</p> 
    {dateString?.includes("T") && (
        <p class="node-time">
            {time?.toLocaleString().slice(0, -6)}{time?.toLocaleString()?.includes("AM") ? "am" : "pm"}
        </p>
    )}
</div>