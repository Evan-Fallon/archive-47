---
import '../styles/global.css';
import ArchiveHeader from '../components/ArchiveHeader.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout>
    <style is:global>
        .content-scroller {
            overflow-y: scroll;
            max-height: 100%;
            height: 100%;
            
        }
        .content-sizer {
            display: grid;
            height: fit-content;
            grid-template-columns: 1fr 540px 540px 1fr;
            > * {
                grid-column: 2 / 4;
            }
        }
        content-bg
    </style>
<div class="content-scroller">
            <ArchiveHeader/>
            <div class="content-sizer">
        	<slot/>
        </div>
        </div>
</Layout>
