---
import ArchiveHeader from '../components/ArchiveHeader.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout>
<style is:global>
.timeline-base {
    display: grid;
    grid-template-columns: min-content auto 40px auto;
    gap: 0px;
    background: var(--secondary-bg);
    padding: 0 2rem;
}
.display-node {
    margin: 16px 0;
    --title-padding: 16px;
    box-sizing: border-box;
    .name-link {
        a {
            font-weight: bold;
            font-size: 1.1em;
            text-decoration: none;
            color: var(--text-color);
        }
    }
    &.basic {
        padding: var(--title-padding);
        border: 1px solid var(--border-basic);
        border-radius: 6px;
        background: var(--primary-bg);
        transition-property: border-color;
        transition-duration: 800ms; 
        color: var(--text-color);
        .name-link {
            display: flex;
            align-items: center;
        }
        a {
            color: var(--text-color-important)
        }
        &:hover {
            border: 1px solid var(--border-hover);
            transition-duration: 50ms;
        } 
    }
    &.minor {
        margin: 12px 0;
        display: flex;
        align-items: center;
        .name-link {   
            gap: .5em;
            align-items: center;
            height: fit-content;
            width: fit-content;
            a { 
                color: var(--text-color-important);
                font-size: 1em;
                text-box-trim: trim-both;
                text-box-edge: ex alphabetic;
            }
        }

    }
    &.image {
        display: grid;
        max-height: 225px;
        border: 1px solid var(--border-basic);
        border-radius: 6px;
        overflow: hidden;
        grid-template-areas: "pile";
        box-sizing: border-box;
        transition-property: border-color;
        transition-duration: 800ms; 
        > * {
            grid-area: pile;
        }
        .name-link {
            display: flex;
            gap: .5em;
            align-items: center;
            height: fit-content;
            width: fit-content;
            background: hsl(from var(--primary-bg) h s l / .9);
            padding: 8px 24px;
            border-radius: 0 0 12px 0;
            z-index: 1;
            
            a {
                text-box-trim: trim-both;
                text-box-edge: cap alphabetic;
                font-weight: bold;
                font-size: 1.1em;
                text-decoration: none;
                color: var(--text-color-important);
            }
        }

        img {
            width: 100%;
            height: 100%;
            min-height: 200px;
            object-fit: cover;
            object-position: center;
        }
        &:hover {
            border: 1px solid hsl(0 0 30);
            transition-duration: 50ms;
        } 
    }
    .content-embed {
        font-size: 1em;
        padding: 8px 0 0 0;
    }
}
.popover-buttons {
    display: flex;
    gap: 8px;
    margin-left: 32px;
    margin-right: 8px;
}
.commentary-button, .content-button {
    opacity: 0;
    border: none;
    display: inline flex;
    font-weight: 1000;
    text-align: center;
    place-content: center;
    place-items: center;
    transition-property: opacity;
    transition-duration: 250ms;
    flex-shrink: 0;
    background: var(--border-basic);
    color: var(--primary-bg);
    font-size: 1.3rem;
    overflow: hidden;
    height: 28px;
    width: 28px;
    border-radius: 4px;

}

.node-commentary-popover, .node-content-popover {
    max-width: 480px;
    border: 1px solid var(--border-basic);
    background: var(--primary-bg);
    color: var(--text-color);
    font-family: Noto Sans;
    font-size: .75em;
    padding: 1em;
    border-radius: 6px;
    position-area: top;
    position-try: flip-block;
    margin-bottom: 10px;
    opacity: 0;
    transition: opacity 200ms;
    &:popover-open {
        opacity: 1;
        @starting-style {
            opacity: 0;
        }
    }
}

.timeline-cell:hover .commentary-button,
.timeline-cell:hover .content-button {
    opacity: 1;
}

.timeline-cell {
    display: grid;
    align-items: center;
    grid-column: 2 / 3;
    width: 100%;
    &.node {
        transform-origin: left;
        animation-name: node-reveal;
        animation-duration: 1000ms;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-delay: var(--anim-delay);
    }
    &:has(.display-node.image) {
        align-items: inherit;
        grid-column: 1 / 5 !important;
        margin: 0 -2rem;
        width: calc(100% + 4rem);
        .display-node {
            border-width: 1px 0 1px 0;
            border-style: solid;
            border-color: var(--border-basic);
            border-radius: 0;
        } 
    }
    p {
        margin: 0;
    }
    &.year {
        color: var(--text-color-important);
        font-weight: 600;
        font-size: 3rem;
        text-align: center;
        place-items: center;
        margin: 0 -2rem;
        width: calc(100% + 4rem);
    } 
    hr {
        width: 100%;
        border: none;
        border-bottom: 1px solid hsl(0 0 30);
        margin: 0px;
    }
    &.month {
        text-align: right;
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text-color);
        animation-name: opacity-reveal;
        animation-duration: 800ms;
        animation-timing-function: ease-in;
        animation-fill-mode: both;
        animation-delay: var(--anim-delay);
        margin-top: 24px;
    }
}
.timeline-line {
    background: var(--border-basic);
    width: 1px;
    height: calc(100% - 64px);
    justify-self: center;
    animation-name: line-go-down;
    animation-duration: 3000ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    margin: 48px 0;
}
.node-circles {
    width: 15px;
    height: 15px;
    border-radius: 20px;
    border: 1px solid var(--border-basic);
    background: var(--secondary-bg);
    place-self: center;
}

.node-circles {
    width: 15px;
    height: 15px;
    border-radius: 20px;
    border: 1px solid var(--border-basic);
    background: var(--secondary-bg);
    place-self: center;
    animation-name: opacity-reveal;
    animation-duration: 500ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    animation-delay: var(--anim-delay);
    &.Minor {
        width: 10px;
        height: 10px;
        border-radius: 15px;
        border: 1px solid var(--border-basic);
        background: var(--secondary-bg);
    }
}
.node-day-time {
    font-size: 0.8rem;
    color: var(--text-color);
    place-self: center right;
}
#span-column {
    display: grid;
    width: auto;
    height: 100%;
    grid-template-rows: subgrid;
    margin-right: 8px;
    position: relative;
    gap: 0 4px;
}

.timeline-span {
    width: 20px;
    height: calc(100% - 8px);
    margin: -48px auto auto 0;
    background: light-dark(
        hsl(from var(--border-basic) h s l / .3),
        hsl(from var(--border-basic) h s l / .1)
    );
    border-color:  light-dark(
        hsl(from var(--border-basic) h s l / 1),
        hsl(from var(--border-basic) h s l / .4)
    );
    border-width: 0 1px 0 1px;
    border-style: solid;
    transition: border 250ms ease, background 400ms ease;
    &:hover {
        border-color: hsl(from var(--border-basic) h s l / .7);
        background: hsl(from var(--border-basic) h s l / .2);
        .span-name {
            opacity: 1;
            transform: translateX(25px);
        }
    }
} 

.span-name {
    opacity: 0;
    pointer-events: none;
    place-self: right;
    position: sticky;
    width: 125px;
    top: 50%;
    padding: .5em;
    border-radius: 8px;
    transition: opacity 100ms ease, transform 300ms ease;
    background: var(--primary-bg);
    border: 1px solid var(--border-basic);
    color: var(--text-color);
    z-index: 5;
}




@media only screen and (max-width: 640px) {
    
    h1 {
        font-size: 2em;
    }
    .display-node {    
        &.basic  {
            grid-column: 2 / 5; 
            font-size: 1.15em;
            border-width: 0px;
            paddng: 4px;   
            &:hover {
                border-width: 0px;
            }
            .content-embed {
                font-size: 1em;
            }
        }
        &.minor {
            margin-left: 12px;
        }
        &.image {
            grid-column: 1 / 5; 
            grid-row: 1 / 2;
            grid-template-columns: subgrid;
            margin: 0;
            z-index: 3;
            border: none !important;
            .name-link {
                width: auto;
                grid-column: 2 / 5;
                grid-row: 1 / 2;
                margin: 0 0 0 -12px;
                border-radius: 0;
                padding: 8px 8px 12px 28px;
                border-radius: 0 0 0 8px;
                .commentary-button {
                    margin-left: auto
                }
            }
            img {
                grid-column: 1 / 5;
            }
            .image-node-day {
                display: none;
            }
        }
    }
    .popover-buttons {
        margin-left: auto;
        padding-left: 8px;
    }
    .content-button, .commentary-button { 
        opacity: 1;

    }
    .timeline-base {
        grid-template-columns: auto 10px auto;
        gap: 0 4px;
        padding: 0px;
    }
    .timeline-cell:has(.display-node.image) {
        margin: 0px;
        width: 100%;
    }

    .year {
        font-size: 2.5rem;
        margin: 0;
        padding: 0;        
        &:not(.spacer) > * {
           
           display: flex;
           place-content: center;
           top: 0%;
           background: var(--secondary-bg);
           width: 100%;
           top: 0%;
           z-index: 7;
           height: 55px;
        }
    }
    .timeline-range.year {
        display: flex;
        align-items: start;
        overflow-y: visible;
        height: 100%;
        position: relative;
        div {
            position: sticky;
            text-align: center;
            height: 55px;
            top: 0px;
            width: 100%;
            margin: 0px;
            p {
                margin: auto;
                font-weight: 600;
            }
        }
    }
    .timeline-cell.year {
        height: 55px;
    }
    
    .timeline-cell.month {
        grid-column: 1 / 5 !important;
        align-items: start;
        margin: 0;
        border-color: var(--primary-bg);
        border-style: solid;
        border-width: 0px 0 0px 0;
        width: 100%;
        text-align: center;
        position: relative;
        overflow-y: visible;
        height: 100%;
        &:not(.spacer) p {
             height: min-content;
           background: var(--border-basic);    
           position: sticky;
           top: 55px;
           z-index: 6;
        }
    }
    .node-circles {
        grid-column: 2 / 3 !important;
        display: none; 
    }
    #span-column {
        margin-left: 8px !important;
        gap: 0px 2px;
        grid-auto-columns: min-content;
    }
    .timeline-span {
        width: 20px;
        background: hsl(from var(--border-basic) h s calc(l*.5) );
        border: none;
        border-radius: 4px;
        &:hover {
            background: hsl(from var(--border-basic) h s calc(l));
        }
    }
    .timeline-line { 
        grid-column: 2 / 3 !important;
        display: none;
    }
    .timeline-cell.node {
        grid-column: 2 / 5 !important;
        margin: 0;
    }
    .timeline-cell.node:has(.basic), .timeline-cell.node:has(.image) {
        grid-column: 1 / 5 !important;
        background: var(--primary-bg);
        display: grid;
        grid-template-columns: subgrid;
    }
    
    .node-day-time {
        grid-column: 1 / 2 !important;
        font-size: 1em;
        display: flex; 
        flex-direction: column;
        background: hsl(from var(--primary-bg) h s l / .75);
        padding: 0 4px;
        border-radius: 16px;
        border-color: var(--border-basic);
        border-width: 0px;
        border-style: solid;
        margin: auto;
        padding: 1px 6px;
        border-radius: 0px;
        z-index: 4;
        p {
            padding: 0;
            height: auto;
            margin: 0;
        }
        .node-day {
            font-weight: bold;
        }
        .node-time {
            font-size: .9em;
        }
        &.Minor {
            background: var(--secondary-bg);
        }
    }
    .web-header.web-header {
        animation-name: none;
    }
}

@keyframes line-go-down {
    from {
        max-height: 0%;
    }
    to {
        max-height: 100%;
    }
}

    </style>
<div class="content-scroller">
<ArchiveHeader/>
<div class="content-sizer">
<slot/>
</div>
</div>
</Layout>
