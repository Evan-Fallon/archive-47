---
import ArchiveHeader from '../components/ArchiveHeader.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Archive-47</title>
        <style is:global>
            :root {
                color-scheme: light dark;
            }
            html {
                height: 100%;
                width: 100%;
            }
            body {
                --color-accent: hsl(27, 86%, 60%);
                --primary-bg: light-dark(hsl(0 0 95), hsl(0 0 3));
                --secondary-bg: light-dark(hsl(0 0 90), hsl(0 0 6));
                --text-color: light-dark(hsl(0 0 30), hsl(0 0 50));
                --text-color-important: light-dark(hsl(0 0 10), hsl(0 0 70));
                --border-basic: light-dark(hsl(0 0 70), hsl(0 0 20));
                --border-hover: light-dark(hsl(0 0 50), hsl(0 0 30));
                --mobile-width: 640px;
                background: var(--primary-bg);
                margin: 0;
                max-width: 100%;
                height: 100%;
                margin: 0;
                font-family: "Noto Sans", "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                color: var(--text-color); 
                overflow: hidden;     
        
            }
            h1 {
            font-weight: 1000;
            font-size: calc(1rem + 2cqi);
            text-align: center;
            color: var(--text-color-important);
            }
            .pile {
                display: grid;
                grid-template-areas: "pile";
                place-items: center;
                & > * {
                    grid-area: pile;
                }
            }
            .topic-header {
                height: min-content;
            }
            .content-scroller {
                overflow-y: scroll;
                max-height: 100%;
                height: 100%;
                overflow-x: hidden;
                max-width: 100%;
                
            }
            .content-sizer {
                display: grid;
                height: fit-content;
                grid-template-columns: auto minmax(auto, 540px) minmax(auto, 540px) auto;
                color: var(--text-color);
                max-width: 100%;
                & > * {
                    grid-column: 2 / 4;
                }
            }

            .link-holder {
                display: grid;
                gap: 2rem;
                grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
                padding: 64px;
                }
            .view-link {
            height: auto;
            width: 100%;
            aspect-ratio: 3 / 2;
            box-sizing: border-box;
            display: flex;
            overflow: hidden;
            justify-content: center;
            align-items: center;
            text-align: center;
            border: 1px solid var(--border-basic);
            
            border-radius: 12px;
            text-decoration: none;
            color: var(--text-normal);
            padding: 2rem;
            font-weight: 600;
            font-size: 1.2rem;
            vertical-align: text-top;
            transition-property: border, background-color, ;
            transition-duration: 0.8s, 2s, 2s;
            background: var(--secondary-bg);
            transition-timing-function: ease-in-out, ease-in-out, ease-out;
            &:hover {
                border: 1px solid hsl(0 0 25);
                transition-duration: 0.2s, .5s;
            }
            }
            @media only screen and (max-width: 640px) {
                .web-header.web-header {
                    height: 40px;
                    box-sizing: border-box;
                    animation-name: none;
                    top: 0px;
                    background: var(--primary-bg);
                }
            }
        </style>
    </head>
    <body>
        <div class="content-scroller">
            <ArchiveHeader/>
            <div class="content-sizer">
                <slot/>
            </div>
        </div>
    </body>
</html>