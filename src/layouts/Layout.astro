        transition-property: border-color;
        transition-duration: 800ms; 
        > * {
            grid-area: pile;
        }
        .name-link {
            display: flex;
            gap: .5em;
            align-items: center;
            height: fit-content;
            width: fit-content;
            background: hsl(from var(--primary-bg) h s l / .8);
            padding: 8px 24px;
            border-radius: 0 0 12px 0;
            z-index: 1;
            
            a {
                text-box-trim: trim-both;
                text-box-edge: cap alphabetic;
                font-weight: bold;
                font-size: 1.1em;
                text-decoration: none;
                color: var(--text-color-important);
            }
        }
        img {
            width: 100%;
            height: 100%;
            min-height: 200px;
            object-fit: cover;
            object-position: center;
        }
