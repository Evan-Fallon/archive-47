    border-radius: 2px;
    height: 1rem;
    font-size: .8em;
    font-weight: 1000;
    text-align: center;
    place-content: center;
    place-items: center;
    transition-property: opacity;
    transition-duration: 250ms;
}

.node-commentary-popover, .node-content-popover {
    max-width: 480px;
    border: 1px solid var(--border-basic);
    background: var(--primary-bg);
    color: var(--text-color);
    font-family: Noto Sans;
    font-size: .75em;
    padding: 1em;
    border-radius: 6px;
    position-area: top;
    position-try: flip-block;
    margin-bottom: 10px;
    opacity: 0;
    transition: opacity 200ms;
    &:popover-open {
        opacity: 1;
        @starting-style {
            opacity: 0;
        }
    }
}
