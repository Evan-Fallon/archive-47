        <style is:global>
            :root {
                color-scheme: light dark;
            }
            html {
                height: 100%;
            }
            body {
                --color-accent: hsl(27, 86%, 60%);
                --primary-bg: hsl(0 0 3);
                --secondary-bg: light-dark(hsl(0 0 85), hsl(0 0 6));
                --text-color: light-dark(hsl(0 0 30), hsl(0 0 50));
                --text-color-important: light-dark(hsl(0 0 10), hsl(0 0 70));
                --border-basic: light-dark(hsl(0 0 70), hsl(0 0 20));
                --border-hover: light-dark(hsl(0 0 50), hsl(0 0 30));
                background: var(--primary-bg);
                margin: 0;
                width: 100%;
                height: 100%;
                margin: 0;
                font-family: Noto Sans !important;
                color: var(--text-color); 
                overflow: hidden;              
            }
            h1 {
            font-weight: 1000;
            font-size: 4rem;
            text-align: center;
            color: var(--text-color-important);
            }
            .pile {
                display: grid;
                grid-template-areas: "pile";
                place-items: center;
                & > * {
                    grid-area: pile;
                }
            }
            .topic-header {
                height: min-content;
            }
            .content-scroller {
                overflow-y: scroll;
                max-height: 100%;
                height: 100%;
            }
            .content-sizer {
                display: grid;
                height: fit-content;
                grid-template-columns: 1fr 540px 540px 1fr;
                color: var(--text-color);
                & > * {
                    grid-column: 2 / 4;
                }
            }
            .display-node {
    margin: 16px 0;
    --title-padding: 16px;
    box-sizing: border-box;
    .name-link {
        a {
            font-weight: bold;
            font-size: 1.1em;
            text-decoration: none;
            color: var(--text-color);
        }
    }
    &.basic {
        padding: var(--title-padding);
        border: 1px solid var(--border-basic);
        border-radius: 6px;
        background: var(--primary-bg);
        transition-property: border-color;
        transition-duration: 800ms; 
        color: var(--text-color);
        a {
            color: var(--text-color-important)
        }
        &:hover {
            border: 1px solid var(--border-hover);
            transition-duration: 50ms;
        } 
    }
    &.minor {
        margin: 12px 0;
