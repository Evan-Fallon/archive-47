---
import '../styles/global.css';
import ArchiveHeader from '../components/ArchiveHeader.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
        
<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
        margin: 0;
        background: radial-gradient(hsl(0 0 10), hsl(0 0 2)) !important;
        font-family: Noto Sans !important;
        color: hsl(0 0 80); 
        overflow: hidden;
	}
	.content-sizer {
        display: grid;
        grid-template-columns: 1fr 480px 480px 1fr;
        > * {
        grid-column: 2 / 4;
  }
}
.content-scroller {
    overflow-y: scroll;
}

.pile {
    display: grid;
    grid-template-areas: "pile";
    place-items: center;
    > * {
        grid-area: pile;
    }
}

.content-sizer {
    display: grid;
    height: 100vh;
    grid-template-columns: 1fr 480px 480px 1fr;
    > * {
        grid-column: 2 / 4;
    }   
}

.display-node {
    --title-padding: 16px;
    max-width: 720px;
    box-sizing: border-box;
    .name-link {
        a {
            font-weight: bold;
            font-size: 1.1em;
            text-decoration: none;
            color: hsl(0 0 80);
        }
    }

    &.basic {
        padding: var(--title-padding);
        border: 1px solid hsl(0 0 20);
        border-radius: 16px;
        background: hsl(0 0 3);
        transition-property: border-color;
        transition-duration: 800ms; 
        &:hover {
            border: 1px solid hsl(0 0 30);
            transition-duration: 50ms;
        } 
    }
    &.minor {
        margin: 12px 0;
        .name-link a { 
            color: hsl(0 0 60);
            font-size: .85em;
        }
    }
    &.image {
        display: grid;
        max-height: 180px;
        border: 1px solid hsl(0 0 50);
        border-radius: 16px;
        overflow: hidden;
        max-width: 720px;
        grid-template-areas: "pile";
        box-sizing: border-box;
        > * {
            grid-area: pile;
        }
        .name-link {
            height: fit-content;
            width: fit-content;
            background: color-mix(in srgb, black, transparent 10%);
            padding: 8px 24px;
            border-radius: 0 0 12px 0;
            z-index: 1;
            a {
                font-weight: bold;
                font-size: 1.1em;
                text-decoration: none;
                color: hsl(0 0 80);
            }
        }
        img {

            width: 100%;
            height: 100%;
            min-height: 200px;
            object-fit: cover;
            object-position: center;
        }
    }
    .content-embed {
        font-size: 13px;
        padding: 8px 0 0 0;
    }
}
    .commentary-button {
        opacity: 0;
        background: transparent;
        display: inline flex;
        color: hsl(0 0 20);;
        border: 1px solid hsl(0 0 20);
        border-radius: 4px;
        height: 1rem;
        font-size: .6em;
        text-align: center;
        place-content: center;
        place-items: center;
        transition-property: opacity;
        transition-duration: 250ms;
    }
    .node-commentary {
        max-width: 480px;
        border: 1px solid hsl(0 0 20);
        background: hsl(0 0 3);
        color: grey;
        font-family: Noto Sans;
        font-size: .75em;
        padding: 1em;
        border-radius: 16px;
        position-area: top;
        position-try: flip-block;
        margin-bottom: 10px;
        opacity: 0;
        transition: opacity 200ms;
        &:popover-open {
            opacity: 1;
            @starting-style {
                opacity: 0;
            }
        }
    }
.timeline-cell:hover .commentary-button {
    opacity: 1;
}

</style>

	</head>
	<body>
        <div class="content-scroller">
            <ArchiveHeader/>
            <div class="content-sizer">
        	<slot/>
        </div>
        </div>
	</body>
</html>
