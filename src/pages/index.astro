---
import Layout from '../layouts/Layout.astro';
import Debug from 'astro/components/Debug.astro';
import { vaultQuery, type VaultNote }  from '../utils/vaultQuery';

const query = await vaultQuery()
const seriesPages = query
  .filter(note => note.Frontmatter?.["Archive-47"] === true && note.Frontmatter?.["A47-Class"]?.includes("series"))

const notePages = query
  .filter(note => note.Frontmatter?.["Archive-47"] === true && note.Frontmatter?.["A47-Class"] && note.Frontmatter?.["A47-Class"] !== "series")

---
<style>
.link-holder, .file-links {
  display: flex;
  height: 480px;
  flex-direction: column;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
  padding: 32px;
  background: var(--secondary-bg);
  border: 1px solid var(--border-basic);
  border-radius: 12px;
  margin: 16px;
}
.link-holder {
    grid-column: 2 / 3;

}
.file-links {
    grid-column: 3 / 4;
}
  
.view-link {
  display: flex;
  height: auto;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  justify-content: left;
  align-items: center;
  text-align: right;
  text-decoration: none;
  padding-left: 8px;
  color: var(--text-normal);
  font-size: .9rem;
  vertical-align: text-top;
  transition-property: border, background-color;
  transition-duration: 0.8s, 2s, 2s;
  transition-timing-function: ease-in-out, ease-in-out, ease-out;
  &:hover {
      outline: 1px solid hsl(0 0 25);
      transition-duration: 0.2s, .5s;
  }
}
</style>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>LibDocket</title>
  </head>
  <body>
    <Layout>
      <div class="series-node full">
        <style>
          .series-node.full {
            display: grid;
            grid-template-columns: 1fr 2fr;
            height: 240px;
            width: 720px;
            background: var(--secondary-bg);
            border: 1px solid var(--border-basic);
            border-radius: 12px;
            overflow: hidden;
            margin-top: 64px;
          }
          .series-image {
            grid-column: 1 / 2;
            grid-row: 1 / 2;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
            overflow: hidden;
            img {
              width: 100%;
              height: 100%;
              object-fit: cover;
            }
          }
          .series-content {
            grid-column: 2 / 3;
            grid-row: 1 / 2;
            display: grid;
            grid-template-rows: 25px 1fr auto;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
            padding: 16px;
            h3 {
              font-size: 1.5rem;
              font-weight: 600;
              margin-bottom: 2px;
              text-align: center;
            }
          }
          .series-description {
            display: flex;
            font-size: .75rem;
            justify-content: center;
            align-items: center;
            width: 100%;
            text-align: center;
            p {
              margin: 0;
              padding: 0 16px;
            }
          }
          .series-components {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            gap: 16px;
            overflow-x: auto;
          }
          .series-component {
            display: flex;
            justify-content: center;
            align-items: center;
            width: auto;
            height: 40px;
            background: var(--primary-bg);
            border: 1px solid var(--border-basic);
            border-radius: 8px;
            text-decoration: none;
            color: var(--text-normal);
            font-size: 1rem;
            padding: 8px;
          }
        </style>
        <div class="series-content">
          <h3>The C.E.C.O.T. Lie</h3>
          <div class="series-description">
            <p>
              The C.E.C.O.T. Lie was the US Government's attempts to circumvent law, civil rights, and court orders to deport and detain 240+ Venezuelans and one El Salvadoran man, while maintianing a false narrative publicly about the jurisdiction of the detainment and the criminal status of the people detained
            </p>
            </div>
          <div class="series-components">
            <a class="series-component" href="./the-cecot-lie-timeline">View Timeline</a>
          </div>
        </div>
        <div class="series-image">
          <img src="./images/Philip-Holsinger02.jpg"/>
        </div>
      </div>
    </Layout>
  </body>
</html>