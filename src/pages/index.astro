---
import Layout from '../layouts/Layout.astro';
import Debug from 'astro/components/Debug.astro';
import { vaultQuery, type VaultNote }  from '../utils/vaultQuery';

const query = await vaultQuery()
const seriesPages = query
  .filter(note => note.Frontmatter?.["Archive-47"] === true && note.Frontmatter?.["A47-Class"]?.includes("series"))

const notePages = query
  .filter(note => note.Frontmatter?.["Archive-47"] === true && note.Frontmatter?.["A47-Class"] && note.Frontmatter?.["A47-Class"] !== "series")

---
<style>
.link-holder, .file-links {
  display: flex;
  height: 480px;
  flex-direction: column;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
  padding: 32px;
  background: var(--secondary-bg);
  border: 1px solid var(--border-basic);
  border-radius: 12px;
  margin: 16px;
}
.link-holder {
    grid-column: 2 / 3;

}
.file-links {
    grid-column: 3 / 4;
}
  
.view-link {
  display: flex;
  height: auto;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  justify-content: left;
  align-items: center;
  text-align: right;
  text-decoration: none;
  padding-left: 8px;
  color: var(--text-normal);
  font-size: .9rem;
  vertical-align: text-top;
  transition-property: border, background-color;
  transition-duration: 0.8s, 2s, 2s;
  transition-timing-function: ease-in-out, ease-in-out, ease-out;
  &:hover {
      outline: 1px solid hsl(0 0 25);
      transition-duration: 0.2s, .5s;
  }
}
</style>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Vault Test</title>
  </head>
  <body>
    <Layout>

    </Layout>
  </body>
</html>