---
import { vaultQuery } from '../utils/vaultQuery';
import Layout from '../layouts/Layout.astro';
import { queryToTimelineLists } from '../utils/queryToTimelineList';
import  TimelineVertical from '../components/TimelineVertical.astro';
import { Temporal } from '@js-temporal/polyfill';

const queryPromise = await vaultQuery()
const inlineEvents = queryPromise
  .flatMap(note => note.inlineProperties)
  .filter(inline => inline.Series?.toLowerCase().includes("the cecot lie".toLowerCase()))
  .sort((a, b) => Temporal.PlainDateTime.compare(a.Date, b.Date))
const timeline = queryToTimelineLists(inlineEvents)



---
<Layout>
  <h1 class="topic-header">
      The C.E.C.O.T. Lie
  </h1>
  <TimelineVertical timeline={timeline}/>
</Layout>