---
import { inlineQuery } from '../utils/inlineQuery';
import Layout from '../layouts/Layout.astro';
import { queryToTimelineLists } from '../utils/queryToTimelineList';
import  TimelineVertical from '../components/TimelineVertical.astro';

const inlineProps = await inlineQuery("the cecot lie")
const timeline = queryToTimelineLists(inlineProps)



---
<Layout>
  <h1 class="topic-header">
      The C.E.C.O.T. Lie
  </h1>
  <TimelineVertical timeline={timeline}/>
</Layout>