---
import { getVar } from '../utils/ingest';
import AtomDisplayNode from '../components/AtomDisplayNode.astro'
import Layout from '../layouts/Layout.astro';

const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
const pages = await getVar()
const inlineProps = pages
  .flatMap(page => page.inlineProperties)
  .filter(atom => atom.raw.toLowerCase().includes("the cecot lie"))
  .sort((a, b) => a.Date - b.Date)


let currentNodes: any[] = []
let currentYears = [{year: new Date (inlineProps[0].Date).getFullYear(), yIndex: 1, yEnd: 2}]
let currentMonths = [{month: months[new Date(inlineProps[0].Date).getMonth()], yIndex: 2}]
let currentSpans = []
let yIndex = 3
inlineProps.forEach(atom => {
  const thisYear = new Date(atom.Date).getFullYear()
  const thisMonth = months[new Date(atom.Date).getMonth()]
    if (thisYear !== currentYears[currentYears.length - 1].year) {
        currentYears[currentYears.length - 1].yEnd = yIndex
        currentYears.push({year: thisYear, yIndex: yIndex, yEnd: yIndex + 1})
        yIndex++
        currentMonths.push({month: thisMonth, yIndex: yIndex})
        yIndex++
    } 
    else if (thisMonth !== currentMonths[currentMonths.length - 1].month) { 
        yIndex++
        currentMonths.push({month: thisMonth, yIndex: yIndex})
        yIndex++
    }
    if (atom?.["Span Start"]) {
        currentSpans.push({name: atom["Span Start"], date: atom.Date, yIndex: yIndex, yEnd: yIndex + 1})    
    }
    if (atom?.["Span End"]) {
        const endSpan = currentSpans.find(span => span.name === atom["Span End"])
        if (endSpan) {
            endSpan.yEnd = yIndex
        }
    }
    currentNodes.push({...atom, Index: yIndex})
    yIndex++
})  
currentYears[currentYears.length - 1].yEnd = yIndex 

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Vault Test</title>
  </head>
  <body>
    <a href="./">Back to Index</a>
    <Layout>
    <style is:global> 

.body-sizer {
  display: grid;
  grid-template-columns: 1fr 480px 480px 1fr;
  > * {
    grid-column: 2 / 4;
  }
}

h1 {
  font-weight: 1000;
  font-size: 4rem;
}

.timeline-base {
  display: grid;
  grid-template-columns: auto auto 60px auto;
  gap: 0px
}

.display-node {
  margin: 16px 0;
  
}

.timeline-cell {
  display: grid;
  grid-column: 2 / 3;
  width: 100%;
  &.node {
    transform-origin: left;
      animation-name: node-reveal;
  animation-duration: 1000ms;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
  animation-delay: var(--anim-delay);
  }
  p {
    margin: 0;
  }
  &.year {
  font-weight: 600;
  font-size: 3rem;
  text-align: center;
  place-items: center;
} 
  hr {
    width: 100%;
    border: none;
    border-bottom: 1px solid hsl(0 0 30);
  }
  &.month {
    text-align: right;
    font-weight: 600;
    font-size: 1.1rem;
    color: hsl(0 0 70);
    animation-name: opacity-reveal;
    animation-duration: 800ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    animation-delay: var(--anim-delay);
    border-bottom: 1px solid hsl(0 0 20);
  }
}
.timeline-line {
    background: hsl(0 0 30);
    width: 1px;
    height: 100%;
    justify-self: center;
    animation-name: line-go-down;
    animation-duration: 3000ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    margin: 48px 0;
}

.node-circles {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border: 1px solid hsl(0 0 30) ;
    background: hsl(0 0 5);
    place-self: center;
    animation-name: opacity-reveal;
    animation-duration: 500ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    animation-delay: var(--anim-delay);
     &.Minor {
        width: 15px;
        height: 15px;
        border-radius: 15px;
        border: 1px solid hsl(0 0 25) ;
        background: hsl(0 0 5);
    }
}
.node-day-time {
    font-size: 0.8rem;
    color: hsl(0 0 30);
    place-self: center right;
        animation-name: opacity-reveal;
    animation-duration: 500ms;
    animation-timing-function: ease-in;
    animation-fill-mode: both;
    animation-delay: var(--anim-delay);
}

 @keyframes line-go-down {
    from {
        max-height: 0%;
    }
    to {
        max-height: 100%;
    }
}
@keyframes node-reveal {
    from {
      filter: blur(4px);
        opacity: 0;
        transform: rotate3d(.5, 1, 0, 15deg) translateY(70px);
    }
    to {
      filter: blur(0px);
        opacity: 1;
        transform: rotate3d(.5, 1, 0, 0deg) translateY(0px);
    }
} 
 @keyframes opacity-reveal{
    from {
        opacity: 0%;
    }
    to {
        opacity: 100%;
    }
}

</style>
<script define:vars={{ inlineProps }}> console.log("test", inlineProps) </script>
<div class="content-scroller">
<div class="content-sizer">
  <div class="topic-header">
  <h1> The C.E.C.O.T. Lie</h1>
  <p>There are {pages.length} files and {inlineProps.length} CECOT related tags</p>
  <a href="./cecot-home">Back to Summary</a>
  </div>
  <div class="timeline-base">
    {currentYears.map((year, yearInd) => {
    
    return (
        <div class="timeline-line" style={`grid-column: 3 / 4; grid-row: ${year.yIndex + 1} / ${year.yEnd};}`}> 
        </div>
    )})}

    {currentYears.map(year => (
      <div class="timeline-cell year" 
      style={{
        gridColumn: "2 / 5",
        gridRow: `${year.yIndex} / ${year.yIndex + 1}`,
      }}>
        <p>{year.year}</p>
        <hr/>
      </div>
      ))}
  {currentMonths.map(month => (
      <div class="timeline-cell month" 
      style={`
        --anim-delay: ${month.yIndex * 75}ms;
        grid-column: 2 / 3;
        grid-row: ${month.yIndex} / ${month.yIndex + 1};,
      `}>
        <p>{month.month}</p>
      </div>  
      ))}
    {currentNodes.map(atom => (
      <div class="timeline-cell node" 
      style={`
        grid-column: 4 / 5;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 90}ms`
      }>
        <AtomDisplayNode atom={atom}/> 
      </div>  
      ))}
    {currentNodes.map(atom => (
      <div class={`node-circles ${atom.Display}`}
      style={`
        grid-column: 3 / 4;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 125}ms`
      }/>
    ))}
    {currentNodes.map(atom => (
      <div class="node-day-time" 
      style={`
        grid-column: 2 / 3;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 125}ms`
      }>
        <p>{atom.DateString.split("T")[0].split("-")[2]} {atom.DateString.split("T")[1] ? " - " + atom.DateString.split("T")[1] : ""}</p>
      </div>
    ))}


  </div>
</div>
</div>
</Layout>

</body>
</html>