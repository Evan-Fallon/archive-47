---
import { getVar } from '../utils/ingest';
import AtomDisplayNode from '../components/AtomDisplayNode.astro'
import TimelineLayout from '../layouts/TimelineLayout.astro';

const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
const pages = await getVar()
const inlineProps = pages
  .flatMap(page => page.inlineProperties)
  .filter(atom => atom.raw.toLowerCase().includes("2026 usps election interference"))
  .sort((a, b) => Temporal.PlainDateTime.compare(a.Date, b.Date))


let currentNodes: any[] = []
let currentYears = [{year: inlineProps[0].Date.year, yIndex: 1, yEnd: 2}]
let currentMonths = [{month: months[inlineProps[0].Date.month], yIndex: 2}]
let currentSpans: any[] = []
let yIndex = 3
inlineProps.forEach(atom => {
  const thisYear = atom.Date.year
  const thisMonth = months[atom.Date.month]
    if (thisYear !== currentYears[currentYears.length - 1].year) {
        currentYears[currentYears.length - 1].yEnd = yIndex
        currentYears.push({year: thisYear, yIndex: yIndex, yEnd: yIndex + 1})
        yIndex++
        currentMonths.push({month: thisMonth, yIndex: yIndex})
        yIndex++
    } 
    else if (thisMonth !== currentMonths[currentMonths.length - 1].month) { 
        yIndex++
        currentMonths.push({month: thisMonth, yIndex: yIndex})
        yIndex++
    }
    if (atom?.["Span Start"]) {
        currentSpans.push({name: atom["Span Start"], date: atom.Date, yIndex: yIndex, yEnd: yIndex + 1})    
    }
    if (atom?.["Span End"]) {
        const endSpan = currentSpans.find(span => span.name === atom["Span End"])
        if (endSpan) {
            endSpan.yEnd = yIndex
        }
    }
    currentNodes.push({...atom, Index: yIndex})
    yIndex++
})  
currentYears[currentYears.length - 1].yEnd = yIndex 

const spanTracks = []
for (const span of currentSpans) {
    let assigned = false
    for (let i = 0; i < spanTracks.length; i++) {
        if (!spanTracks[i].some(t => !(t.yEnd <= span.yIndex || span.yEnd <= t.yIndex))) {
            spanTracks[i].push(span)
            assigned = true
            break
        }
    }
    if (!assigned) spanTracks.push([span])
}
const numberedSpans = spanTracks.map((track, trackInd) => {
    return (
        track.map(span => {
        return (
         {...span, trackInd: trackInd}
        )})
     )
 }).flat()

---
<TimelineLayout>

  <div class="topic-header">
  <h1>The USPS Mid-Term Interference Timeline</h1>
  </div>
  <div class="timeline-base">
    {currentYears.map((year, yearInd) => {
    
    return (
        <div class="timeline-line" style={`grid-column: 3 / 4; grid-row: ${year.yIndex + 1} / ${year.yEnd};}`}> 
        </div>
    )})}
      <div id="span-column" style={`grid-column: 1 / 2; grid-row: 1 / ${yIndex};`}>
        {numberedSpans.map(span => {
        return (<div style="display:contents">
            <div class="timeline-span" style={`grid-row: ${span.yIndex + 1} / ${span.yEnd +1}; grid-column: ${span.trackInd + 1}`}>
            <div class="span-name" style={`grid-row: ${span.yIndex} / ${span.yEnd +1}; grid-column: ${span.trackInd + 1}`}>
                {span.name}
            </div>
            </div>
            
        </div>
        )})}
    </div>

    {currentYears.map(year => (
      <div class="timeline-cell year" 
      style={{
        gridColumn: "1 / 5",
        gridRow: `${year.yIndex} / ${year.yIndex + 1}`,
      }}>
        <p>{year.year}</p>
        <hr/>
      </div>
      ))}
  {currentMonths.map(month => (
      <div class="timeline-cell month" 
      style={`
        --anim-delay: ${month.yIndex * 75}ms;
        grid-column: 2 / 3;
        grid-row: ${month.yIndex} / ${month.yIndex + 1};,
      `}>
        <p>{month.month}</p>
      </div>  
      ))}

    {currentNodes.map(atom => (
      <div class={`node-circles ${atom.Display}`}
      style={`
        grid-column: 3 / 4;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 125}ms`
      }/>
    ))}
    {currentNodes.map(atom => (
      <div class="node-day-time" 
      style={`
        grid-column: 2 / 3;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 125}ms`
      }>
        <p>{atom.OrdinalDay} {atom.DateString.split("T")[1] ? " - " + atom.DateString.split("T")[1] : ""}</p>
      </div>
    ))}
    {currentNodes.map(atom => (
      <div class="timeline-cell node" 
      style={`
        grid-column: 4 / 5;
        grid-row: ${atom.Index} / ${atom.Index + 1};
        --anim-delay: ${atom.Index * 90}ms`
      }>
        <AtomDisplayNode atom={atom}/> 
      </div>  
      ))}

  </div>
</TimelineLayout>