---
import { getVar } from '../utils/ingest';
import AtomDisplayNode from '../components/AtomDisplayNode.astro'
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
const pages = await getVar()
let yIndex = 0;
const inlineProps = pages
  .flatMap(page => page.inlineProperties)
  .filter(atom => atom.raw.toLowerCase().includes("the cecot lie"))
  .sort((a, b) => a.Date - b.Date)
  .map((atom) => {
    yIndex++
    return (
      {...atom, Index: yIndex}
    )
  })
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Vault Test</title>
  </head>
  <body>
    <link rel="stylesheet" href="./src/styles/global.css"/>
    <style is:global> 

.body-sizer {
  display: grid;
  grid-template-columns: 1fr 480px 480px 1fr;
  > * {
    grid-column: 2 / 4;
  }
}

h1 {
  font-weight: 1000;
  font-size: 4rem;
}

.timeline-base {
  display: grid;
}
.timeline-cell {
  grid-column: 2 / 3;
}

</style>
<script define:vars={{ inlineProps }}> console.log("test", inlineProps) </script>
<div class="body-sizer">
  <h1> The C.E.C.O.T. Lie</h1>
  <p>There are {pages.length} files and {inlineProps.length} CECOT related tags</p>
  <h2>Timeline</h2>
  <div class="timeline-base">
    <div id="timeline-line" 
    style = {{
      gridRow: `1 / ${inlineProps.length + 1}`,
      gridColumn: "1 / 2",
      border: "1px solid hsl(0 0 20)",
      height: "100%",
      width: "0px"
    }}/>
    {inlineProps.map(atom => (
      <div class="timeline-cell" 
      style={{
        gridRow: `${atom.Index} / ${atom.Index + 1}`,
      }}>
        <AtomDisplayNode atom={atom}/> 
      </div>  
      ))}
  </div>
</div>
</body>
</html>