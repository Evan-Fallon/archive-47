---
import { vaultQuery } from "@utils/vaultQuery";
import path from 'node:path'
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
    const query = await vaultQuery()
    const civilSuits = query.filter(suit => suit.Frontmatter?.["Archive-47"] && suit.Frontmatter?.["A47-Class"] === "civilsuit")
    console.log(civilSuits)
    const para = civilSuits.map(suit => {
        const basename = path.basename(suit.BaseName, path.extname(suit.BaseName))
        console.log(suit.BaseName.toLowerCase().replace(/\s+/g, '-'))
        return ( 
        {
            params: { 
            civilsuits: `${suit.BaseName.replaceAll(" ", "-").replaceAll(".","").toLowerCase()}-home`
            }, 
            props: { 
            fileName: basename,
            frontmatter: suit.Frontmatter

            }
        } 
        )
    })
    return para
}
const { civilsuits } = Astro.params
const { frontmatter, fileName } = Astro.props
---
<Layout>
    {civilsuits}
</Layout>