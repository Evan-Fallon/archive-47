---
import { getVar } from '../utils/ingest';
import SubpageLayout from '../layouts/SubpageLayout.astro';
const pages = await getVar()
const inlineProps = pages
  .flatMap(page => page.inlineProperties)
  .filter(atom => atom.raw.toLowerCase().includes("the cecot lie"))
  .sort((a, b) => a.Date - b.Date)
---
<SubpageLayout>
<style is:global> 
h1 {
  font-weight: 1000;
  font-size: 4rem;
}
.link-holder {
  display: flex;
  gap: 2rem;
}
.view-link {
  height: 200px;
  width: 200px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  border: 1px solid hsl(0 0 20);
  border-radius:32px;
  text-decoration: none;
  color: white;
  padding: 2rem;
  font-weight: 600;
  font-size: 1.5rem;
  vertical-align: text-top;
  transition-property: border, background-color, ;
  transition-duration: 0.8s, 2s, 2s;
  background-color: transparent;
  transition-timing-function: ease-in-out, ease-in-out, ease-out;
  &:hover {
    background-color: hsl(0 0 7);
    border: 1px solid hsl(0 0 25);
    transition-duration: 0.2s, .5s;
  }
}

    </style>
<script define:vars={{ inlineProps }}> console.log("test", inlineProps) </script>
<div class="topic-header">
  <h1> The C.E.C.O.T. Lie</h1>
  </div>
  <div class="link-holder">
  <a class="view-link" href="./cecot-summary">What is the C.E.C.O.T. Lie?</a>
  <a class="view-link" href="./cecot-timeline">Timeline</a>
  <a class="view-link" href="./cecot-directory">Directory</a>
</div>
</SubpageLayout>