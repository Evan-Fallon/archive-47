---
import { vaultQuery } from '../utils/vaultQuery';
import { Marked } from 'marked';
import Layout from '../layouts/Layout.astro';
import { markdownToHtmlPlus } from '../utils/markdownToHtmlPlus';

export async function getStaticPaths() {
  const query = await vaultQuery()
  const pages = query
    .filter(note => note.Frontmatter?.["Archive-47"] === true && note.Frontmatter?.["A47-Class"] === "pdf")
    .map(pdf => ({params: { pdfs: pdf.BaseName.toLowerCase().replace(/\s+/g, '-') }, props: { fileContent: pdf.FileContent, url: pdf.Frontmatter.URL, fileName: pdf.BaseName }}))

      return pages;
}

const { pdfs } = Astro.params;
const { fileContent, url } = Astro.props;
let stringOutput = fileContent
  .split("---")
  .slice(2)
  .join("")
stringOutput = stringOutput
  .replace(/<p>\s*%%[\s\S]*?%%\s*<\/p>|%%[\s\S]*?%%/g, '')
  


const htmlContent = await markdownToHtmlPlus(stringOutput)



---
<style>
  .pdf-disclaimer {
    display: flex;
    width: 100%;
    height: 50px;
    position: fixed;
    top: 0;
    left: 0;
    background: #fff;
    z-index: 1000;
    filter: drop-shadow(0px 4px 0px rgba(0, 0, 0, 0.2));
    place-items: center;
    text-align: center;
  }
  .pdf-disclaimer span {
    font-size: clamp(.65rem, calc(.3rem + 2vw), 1rem);
    margin: 0 auto;
  }
  .pdf-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 96px;
    background: #f9f9f9;
    color: #333;
    font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    text-indent: 2em;
  }
  .pdf-content :global(h1){
    font-size: 1.2em;
  }
  .pdf-content :global(h2){
    font-size: 1.1em;
  }
  .pdf-content :global(h2),
  .pdf-content :global(h3),
  .pdf-content :global(h4),
  .pdf-content :global(h5),
  .pdf-content :global(h6){
    font-size: 1em;
  }
  @media only screen and (max-width: 640px) { 
    .pdf-content {
      padding: 16px;
    }
  }
</style>
<div style="height: 50px"/>
<div class="pdf-disclaimer">
<span>The following is a tool assisted archive of the original source for easier navigation. Mistakes are likely. View the original PDF <a href={url} target="_blank" rel="noopener noreferrer"> here</a>.</span>
</div>
<Layout>
  <div class="pdf-content">
    <span set:html={htmlContent}></span>
  </div>
</Layout>
