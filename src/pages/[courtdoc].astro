---
import { vaultQuery } from '../utils/vaultQuery';
import Layout from '../layouts/Layout.astro';
import { markdownToHtmlPlus } from '../utils/markdownToHtmlPlus';


export async function getStaticPaths() {
  const query = await vaultQuery()
  const pages = query
    .filter(note => note.Frontmatter?.["Archive-47"] === true && note.Frontmatter?.["A47-Class"] === "courtdoc")
    .map(courtdoc => ({params: { courtdoc: courtdoc.SafeName }, props: { fileContent: courtdoc.FileContent, url: courtdoc.Frontmatter.URL }}))

      return pages;
} 
const { courtdoc } = Astro.params;
const { fileContent, url } = Astro.props;
let stringOutput = fileContent
  .split("---")
  .slice(2)
  .join("")
  .replaceAll("\\[REDACTED]", "<span class='redaction'>████████</span>")

stringOutput = await markdownToHtmlPlus(stringOutput)
---
<style>
  .courtdoc-disclaimer {
    width: 100%;
    position: sticky;
    top: 0;
    left: 0;
    background: #fff;
    padding: 1rem;
    z-index: 1000;
    filter: drop-shadow(0px 4px 0px rgba(0, 0, 0, 0.2));
    text-align: center;
  }
  .courtdoc-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 96px;
    background: #f9f9f9;
    color: #333;
    font-family: "Times New Roman", Tinos, Charis SIL, Courier Prime, Georgia, serif;
    text-indent: 2em;
  }
  .courtdoc-content :global(h1){
    font-size: 1.2em;
  }
  .courtdoc-content :global(h2){
    font-size: 1.1em;
  }
  .courtdoc-content :global(h2),
  .courtdoc-content :global(h3),
  .courtdoc-content :global(h4),
  .courtdoc-content :global(h5),
  .courtdoc-content :global(h6){
    font-size: 1em;
  }
  .courtdoc-content :global(p):has(:target), .pdf-content > span > :global(:target), :global(.footnotes li:target) {
    background: hsl(from orange h s l / .1);
    border-radius: 8px;
    outline: 8px solid hsl(from orange h s l / .1);
  }
  .courtdoc-content :global(.redaction) {
    background: black;
  }
 :global(:target) {
    scroll-margin-top: 50cqb;
  }
  :global(.footnotes) {
    font-size: .8em;
    margin: 0;
    text-indent: 0;
  }
  @media only screen and (max-width: 640px) { 
    .courtdoc-content {
      padding: 16px;
    }
  }
</style>
<div class="courtdoc-disclaimer">The following is a tool assisted archive of the original source for easier navigation. Mistakes are likely. View the original PDF <a href={url} target="_blank" rel="noopener noreferrer">here</a>.</div>
<Layout>
  <div class="courtdoc-content">
    <span set:html={stringOutput}></span>
  </div>
</Layout>
